.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header-section {
  background: white;
  padding: 60rpx 40rpx;
  text-align: center;
  border-bottom: 1rpx solid #e9ecef;
}

.type-badge {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.type-badge.asset {
  background: #e8f5e8;
  color: #2e7d32;
}

.type-badge.liability {
  background: #ffeaea;
  color: #c62828;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 20rpx;
}

.amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
}

.info-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 30rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f8f9fa;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #6c757d;
}

.info-value {
  font-size: 30rpx;
  color: #212529;
  font-weight: 500;
}

.info-value.status {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  color: white;
  font-size: 24rpx;
  text-align: center;
  width: fit-content;
}

.info-value.status.active {
  background: #28a745;
}

.info-value.status.dusty {
  background: #868e96;
}

.info-value.status.rented {
  background: #17a2b8;
}

.info-value.status.damaged {
  background: #dc3545;
}

.info-value.status.processed {
  background: #6f42c1;
}

.info-value.status.gifted {
  background: #fd7e14;
}

.info-value.status.sold {
  background: #20c997;
}

.info-value.status.lost {
  background: #495057;
}

/* 负债状态样式 */
.info-value.status.normal {
  background: #28a745;
}

.info-value.status.paid_off {
  background: #6c757d;
}

.info-value.status.overdue {
  background: #dc3545;
}

.info-value.status.prepaid {
  background: #007bff;
}

.notes-content {
  background: #f8f9fa;
  padding: 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #495057;
  line-height: 1.6;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid #e9ecef;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.edit-btn {
  background: #4A90E2;
  color: white;
}

.delete-btn {
  background: #f8f9fa;
  color: #dc3545;
  border: 2rpx solid #dc3545;
}

/* 财务信息样式 */
.financial-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.finance-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.finance-item:last-child {
  border-bottom: none;
}

.finance-item.important {
  background: #f8f9fa;
  margin: 0 -20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: none;
}

.finance-label {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
}

.finance-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #212529;
}

.finance-value.positive {
  color: #28a745;
}

.finance-value.negative {
  color: #dc3545;
}

/* 专项信息样式 */
.special-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.special-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.special-item:last-child {
  border-bottom: none;
}

.special-label {
  font-size: 26rpx;
  color: #6c757d;
}

.special-value {
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
}

.special-value.negative {
  color: #dc3545;
}

/* 折旧信息样式 */
.depreciation-info {
  background: linear-gradient(135deg, #fff9e6 0%, #fffbf0 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #ffc107;
}

.depreciation-info .special-item {
  border-bottom: 1rpx solid rgba(255, 193, 7, 0.2);
  padding: 12rpx 0;
}

.depreciation-info .special-item:last-child {
  border-bottom: none;
}

/* 价值分析样式 */
.value-analysis-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.value-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.value-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #4facfe;
  margin-bottom: 8rpx;
}

.value-label {
  font-size: 24rpx;
  color: #8892b0;
}

/* 使用记录样式 */
.usage-record-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.usage-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.usage-date, .usage-count {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #00f5ff;
  margin-bottom: 8rpx;
}

.usage-label {
  font-size: 24rpx;
  color: #8892b0;
}

.warranty-status {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #10ac84;
  margin-bottom: 8rpx;
}

/* 其他费用样式 */
.section-title-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-with-action .section-title {
  margin-bottom: 0;
  padding-bottom: 0;
}

.add-cost-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.other-costs {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.empty-costs {
  text-align: center;
  color: #8892b0;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.cost-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.cost-item:last-child {
  border-bottom: none;
}

.cost-info {
  display: flex;
  flex-direction: column;
}

.cost-name {
  font-size: 28rpx;
  color: #ccd6f6;
  margin-bottom: 8rpx;
}

.cost-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
}

.cost-date {
  font-size: 24rpx;
  color: #8892b0;
}

.costs-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2px solid rgba(255, 255, 255, 0.2);
}

.summary-label {
  font-size: 28rpx;
  color: #8892b0;
}

.summary-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #ff6b6b;
}

/* 趋势图表样式 */
.trend-subtitle {
  font-size: 24rpx;
  color: #8892b0;
  margin-bottom: 20rpx;
  text-align: center;
}

.chart-container {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 30rpx;
  border: 1px solid rgba(255, 255, 255, 0.1);
  margin-top: 20rpx;
}

.chart-area {
  display: flex;
  height: 400rpx;
  margin-bottom: 20rpx;
}

.y-axis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 120rpx;
  padding-right: 20rpx;
}

.y-label {
  font-size: 20rpx;
  color: #8892b0;
  text-align: right;
}

.chart-main {
  flex: 1;
  position: relative;
  background: linear-gradient(to top, rgba(79, 172, 254, 0.1) 0%, rgba(79, 172, 254, 0.05) 100%);
  border-radius: 8rpx;
  border: 1px solid rgba(79, 172, 254, 0.2);
}

.chart-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.chart-point {
  position: absolute;
  width: 16rpx;
  height: 16rpx;
}

.point-dot {
  width: 100%;
  height: 100%;
  background: #4facfe;
  border-radius: 50%;
  border: 2px solid #0f3460;
  box-shadow: 0 0 10rpx rgba(79, 172, 254, 0.6);
}

.trend-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.8;
  border-radius: 8rpx;
}

.chart-bars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.chart-bar {
  position: absolute;
  bottom: 0;
  background: rgba(79, 172, 254, 0.3);
  border-radius: 4rpx 4rpx 0 0;
  border: 1px solid rgba(79, 172, 254, 0.5);
}

.x-axis {
  display: flex;
  justify-content: space-between;
  padding: 0 120rpx 0 140rpx;
}

.x-label {
  font-size: 20rpx;
  color: #8892b0;
  text-align: center;
  transform: rotate(-45deg);
  transform-origin: center;
}
