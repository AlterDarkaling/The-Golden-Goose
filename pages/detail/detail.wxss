.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header-section {
  background: white;
  padding: 60rpx 40rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 30rpx;
}

.item-logo {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
  flex-shrink: 0;
}

.logo-image-display {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.logo-emoji-display {
  font-size: 48rpx;
}

.logo-default-display {
  font-size: 48rpx;
  opacity: 0.7;
}

.item-info {
  flex: 1;
  text-align: left;
}

.amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
  text-align: center;
}

.type-badge {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  margin-bottom: 12rpx;
}

.type-badge.asset {
  background: #e8f5e8;
  color: #2e7d32;
}

.type-badge.liability {
  background: #ffeaea;
  color: #c62828;
}

.title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.info-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 30rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f8f9fa;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #6c757d;
}

.info-value {
  font-size: 30rpx;
  color: #212529;
  font-weight: 500;
}

.info-value.status {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  color: white;
  font-size: 24rpx;
  text-align: center;
  width: fit-content;
}

.info-value.status.active {
  background: #28a745;
}

.info-value.status.dusty {
  background: #868e96;
}

.info-value.status.rented {
  background: #17a2b8;
}

.info-value.status.damaged {
  background: #dc3545;
}

.info-value.status.processed {
  background: #6f42c1;
}

.info-value.status.gifted {
  background: #fd7e14;
}

.info-value.status.sold {
  background: #20c997;
}

.info-value.status.lost {
  background: #495057;
}

/* 负债状态样式 */
.info-value.status.normal {
  background: #28a745;
}

.info-value.status.paid_off {
  background: #6c757d;
}

.info-value.status.overdue {
  background: #dc3545;
}

.info-value.status.prepaid {
  background: #007bff;
}

.notes-content {
  background: #f8f9fa;
  padding: 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #495057;
  line-height: 1.6;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid #e9ecef;
  display: flex;
  gap: 20rpx;
  z-index: 10;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.edit-btn {
  background: #4A90E2;
  color: white;
}

.delete-btn {
  background: #f8f9fa;
  color: #dc3545;
  border: 2rpx solid #dc3545;
}

/* 财务信息样式 */
.financial-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.finance-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.finance-item:last-child {
  border-bottom: none;
}

.finance-item.important {
  background: #f8f9fa;
  margin: 0 -20rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  border: none;
}

.finance-label {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
}

.finance-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #212529;
}

.finance-value.positive {
  color: #28a745;
}

.finance-value.negative {
  color: #dc3545;
}

/* 专项信息样式 */
.special-info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.special-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f3f4;
}

.special-item:last-child {
  border-bottom: none;
}

.special-label {
  font-size: 26rpx;
  color: #6c757d;
}

.special-value {
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
}

.special-value.negative {
  color: #dc3545;
}

/* 折旧信息样式 */
.depreciation-info {
  background: linear-gradient(135deg, #fff9e6 0%, #fffbf0 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #ffc107;
}

.depreciation-info .special-item {
  border-bottom: 1rpx solid rgba(255, 193, 7, 0.2);
  padding: 12rpx 0;
}

.depreciation-info .special-item:last-child {
  border-bottom: none;
}

/* 价值分析样式 */
.value-analysis-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.value-item {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.value-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #4facfe;
  margin-bottom: 8rpx;
}

.value-label {
  font-size: 24rpx;
  color: #8892b0;
}



/* 其他费用样式 */
.section-title-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title-with-action .section-title {
  margin-bottom: 0;
  padding-bottom: 0;
}

.add-cost-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border-radius: 16rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
  cursor: pointer;
}

.add-cost-btn:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

.other-costs {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  border: 1rpx solid #e9ecef;
}

.empty-costs {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.cost-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cost-item:last-child {
  border-bottom: none;
}

.cost-info {
  display: flex;
  flex-direction: column;
}

.cost-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.cost-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #e74c3c;
}

.cost-date {
  font-size: 24rpx;
  color: #999;
}

.cost-item:active {
  background: #f8f9fa;
  transform: scale(0.98);
}

.costs-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e9ecef;
}

.summary-label {
  font-size: 28rpx;
  color: #666;
}

.summary-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #e74c3c;
}

/* 时间轴样式 */
.timeline-container {
  position: relative;
  margin: 30rpx 0;
  padding: 20rpx 10rpx;
}

.timeline-line {
  position: absolute;
  top: 50%;
  left: 10%;
  right: 10%;
  height: 4rpx;
  background: linear-gradient(90deg, #52c41a 0%, #87d068 25%, #1890ff 50%, #faad14 75%, #ff7875 100%);
  border-radius: 2rpx;
  transform: translateY(-50%);
}

.timeline-nodes {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 1;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  max-width: 120rpx;
}

.node-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.timeline-node.past .node-dot {
  background: #52c41a;
}

.timeline-node.past-mid .node-dot {
  background: #87d068;
}

.timeline-node.current .node-dot {
  background: #1890ff;
  transform: scale(1.2);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.4);
}

.timeline-node.future-near .node-dot {
  background: #faad14;
}

.timeline-node.future-far .node-dot {
  background: #ff7875;
}

.node-card {
  background: #fff;
  border: 1rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 8rpx 6rpx;
  text-align: center;
  min-width: 100rpx;
  max-width: 110rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.node-card.highlight {
  border-color: #1890ff;
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.15);
}

.node-title {
  font-size: 18rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.node-value {
  font-size: 22rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 3rpx;
}

.node-date {
  font-size: 16rpx;
  color: #666;
}

.node-extra {
  font-size: 18rpx;
  color: #1890ff;
  margin-top: 3rpx;
}

/* 关键指标样式 */
.lifecycle-stats {
  display: flex;
  gap: 16rpx;
  margin: 30rpx 0;
}

.stat-item {
  flex: 1;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 16rpx;
  text-align: center;
  border: 1rpx solid #e9ecef;
}

.stat-label {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 6rpx;
  display: block;
}

.stat-value {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.stat-value.negative {
  color: #ff4d4f;
}

.stat-value.warning {
  color: #faad14;
}

/* 里程碑事件样式 */
.milestones {
  margin-top: 30rpx;
}

.milestones-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.milestones-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.milestone-item {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 16rpx;
  border: 1rpx solid #e9ecef;
}

.milestone-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.milestone-info {
  flex: 1;
}

.milestone-title {
  font-size: 24rpx;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}

.milestone-date {
  font-size: 22rpx;
  color: #666;
}

/* 收入统计样式 */
.income-stats {
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
}

/* 薪资历史时间轴样式 */
.salary-timeline {
  position: relative;
  padding: 30rpx 0;
}

.timeline-step {
  position: relative;
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.timeline-step:last-child {
  margin-bottom: 0;
}

.step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 30rpx;
  margin-top: 10rpx;
  z-index: 2;
  position: relative;
}

.step-dot.past {
  background: #6c757d;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 2rpx #6c757d;
}

.step-dot.current {
  background: #007bff;
  border: 3rpx solid #fff;
  box-shadow: 0 0 0 2rpx #007bff;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% {
    box-shadow: 0 0 0 2rpx #007bff;
  }
  50% {
    box-shadow: 0 0 0 8rpx rgba(0, 123, 255, 0.3);
  }
  100% {
    box-shadow: 0 0 0 2rpx #007bff;
  }
}

.step-line {
  position: absolute;
  left: 10rpx;
  top: 30rpx;
  width: 2rpx;
  height: 70rpx;
  background: #e9ecef;
  z-index: 1;
}

.step-content {
  flex: 1;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border-left: 4rpx solid #007bff;
}

.step-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #495057;
  margin-bottom: 8rpx;
  display: block;
}

.step-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #007bff;
  margin-bottom: 8rpx;
  display: block;
}

.step-date {
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 6rpx;
  display: block;
}

.step-duration {
  font-size: 22rpx;
  color: #28a745;
  background: rgba(40, 167, 69, 0.1);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  display: inline-block;
}

/* 工作收入：基础信息样式 */
.basic-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 20rpx;
}

/* 移除不支持的:has()选择器，保持默认2列布局 */

.info-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e9ecef;
}

.info-label {
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 8rpx;
  display: block;
}

.info-value {
  font-size: 28rpx;
  color: #212529;
  font-weight: 500;
}

/* 工作收入：薪资概览样式 */
.salary-overview-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.salary-item {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.2);
}

.salary-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.salary-label {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 工作收入：收入分析样式 */
.income-analysis-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.analysis-item {
  background: #fff;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.analysis-item:hover {
  border-color: #007bff;
  box-shadow: 0 4rpx 12rpx rgba(0, 123, 255, 0.1);
}

.analysis-amount {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #007bff;
  margin-bottom: 8rpx;
}

.analysis-label {
  font-size: 24rpx;
  color: #6c757d;
}

/* 工作收入：收入结构样式 */
.income-category {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e9ecef;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.category-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #495057;
}

.category-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #28a745;
}

.category-desc {
  font-size: 24rpx;
  color: #6c757d;
  margin-top: 8rpx;
}

/* 总收入汇总 */
.total-income-summary {
  background: #fff3cd;
  border: 1rpx solid #ffeaa7;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 20rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.summary-row.main-summary {
  border-bottom: 1rpx solid #ffeaa7;
  margin-bottom: 12rpx;
  padding-bottom: 12rpx;
}

.main-summary .summary-label {
  font-size: 32rpx;
  font-weight: 600;
  color: #856404;
}

.main-summary .summary-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #856404;
}

.summary-label {
  font-size: 28rpx;
  color: #856404;
}

.summary-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #856404;
}

/* 收入发展轨迹样式 */
.income-timeline {
  display: flex;
  align-items: center;
  padding: 40rpx 20rpx;
  margin: 20rpx 0;
}

.income-milestone {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.milestone-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.milestone-dot.start {
  background: #52c41a;
}

.milestone-dot.current {
  background: #1890ff;
}

.income-line {
  flex: 1;
  height: 4rpx;
  background: linear-gradient(90deg, #52c41a 0%, #1890ff 100%);
  border-radius: 2rpx;
  margin: 0 20rpx;
  margin-top: -40rpx;
}

.milestone-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.milestone-content .milestone-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.milestone-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.milestone-content .milestone-date {
  font-size: 22rpx;
  color: #999;
}

.income-stats {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  margin-top: 30rpx;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}
