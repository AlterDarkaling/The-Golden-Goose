.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header-section {
  background: white;
  padding: 60rpx 40rpx;
  text-align: center;
  border-bottom: 1rpx solid #e9ecef;
}

.type-badge {
  display: inline-block;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.type-badge.asset {
  background: #e8f5e8;
  color: #2e7d32;
}

.type-badge.liability {
  background: #ffeaea;
  color: #c62828;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 20rpx;
}

.amount {
  font-size: 48rpx;
  font-weight: bold;
  color: #4A90E2;
}

.info-section {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 30rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f8f9fa;
}

.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #6c757d;
}

.info-value {
  font-size: 30rpx;
  color: #212529;
  font-weight: 500;
}

.info-value.status {
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  color: white;
  font-size: 24rpx;
  text-align: center;
  width: fit-content;
}

.info-value.status.active {
  background: #28a745;
}

.info-value.status.paused {
  background: #ffc107;
  color: #212529;
}

.info-value.status.completed {
  background: #6c757d;
}

.info-value.status.dusty {
  background: #868e96;
}

.info-value.status.rented {
  background: #17a2b8;
}

.info-value.status.damaged {
  background: #dc3545;
}

.info-value.status.processed {
  background: #6f42c1;
}

.info-value.status.gifted {
  background: #fd7e14;
}

.info-value.status.sold {
  background: #20c997;
}

.info-value.status.lost {
  background: #495057;
}

.notes-content {
  background: #f8f9fa;
  padding: 30rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #495057;
  line-height: 1.6;
}

.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid #e9ecef;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.edit-btn {
  background: #4A90E2;
  color: white;
}

.delete-btn {
  background: #f8f9fa;
  color: #dc3545;
  border: 2rpx solid #dc3545;
}
