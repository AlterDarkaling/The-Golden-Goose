<view class="detail-container">
  <!-- 头部信息 -->
  <view class="header-section">
    <view class="type-badge {{type}}">
      {{type === 'asset' ? '💰 资产' : '💳 负债'}}
    </view>
    <view class="title">{{itemData.name}}</view>
    <view class="amount">
      ¥{{displayAmount}}
    </view>
  </view>

  <!-- 基本信息 -->
  <view class="info-section">
    <view class="section-title">基本信息</view>
    <view class="info-grid">
      <view class="info-item">
        <text class="info-label">分类</text>
        <text class="info-value">{{categoryName}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">状态</text>
        <text class="info-value status {{itemData.status}}">{{statusText}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{createDate}}</text>
      </view>
    </view>
  </view>

  <!-- 备注信息 -->
  <view wx:if="{{itemData.notes}}" class="info-section">
    <view class="section-title">备注</view>
    <view class="notes-content">
      <text>{{itemData.notes}}</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-section">
    <button class="action-btn edit-btn" bindtap="handleEdit">编辑</button>
    <button class="action-btn delete-btn" bindtap="handleDelete">删除</button>
  </view>
</view>
