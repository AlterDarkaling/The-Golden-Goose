.about-container {
  padding: 40rpx 30rpx;
  background: var(--bg-color, #f8f9fa);
  min-height: 100vh;
  margin-top: -1rpx;
  padding-top: 41rpx;
}

.about-container.dark-theme {
  background: var(--bg-color-dark, #1e1e1e);
  
  /* 深色主题变量 */
  --card-bg-dark: #2d2d2d;
  --text-color-dark: #ffffff;
  --text-secondary-dark: #aaaaaa;
  --text-tertiary-dark: #888888;
  --item-bg-dark: #404040;
  --border-color-dark: #404040;
  --story-bg-dark: #3d3d2a;
}

/* 页面标题 */
.about-header {
  text-align: center;
  margin-bottom: 60rpx;
  padding: 40rpx 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  color: white;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 书籍部分 */
.books-section {
  margin-bottom: 40rpx;
}

.book-card {
  background: var(--card-bg, #ffffff);
  border-radius: 20rpx;
  margin-bottom: 30rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.dark-theme .book-card {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 4rpx 20rpx rgba(255, 255, 255, 0.08);
}

.book-header {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  padding: 40rpx 30rpx;
  text-align: center;
  color: white;
}

.book-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.book-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.book-author {
  font-size: 24rpx;
  opacity: 0.9;
}

.book-content {
  padding: 40rpx 30rpx;
}

/* 概念部分 */
.concept-section {
  margin-bottom: 40rpx;
}

.concept-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  margin-bottom: 24rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--border-color, #e9ecef);
}

.dark-theme .concept-title {
  color: var(--text-color-dark, #ffffff);
  border-bottom: 2rpx solid var(--border-color-dark, #404040);
}

.concept-item {
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: var(--item-bg, #f8f9fa);
  border-radius: 12rpx;
  border-left: 6rpx solid #667eea;
}

.dark-theme .concept-item {
  background: var(--item-bg-dark, #404040);
}

.concept-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary, #495057);
  display: block;
  margin-bottom: 8rpx;
}

.dark-theme .concept-label {
  color: var(--text-secondary-dark, #aaaaaa);
}

.concept-desc {
  font-size: 24rpx;
  color: var(--text-tertiary, #6c757d);
  line-height: 1.6;
}

.dark-theme .concept-desc {
  color: var(--text-tertiary-dark, #888888);
}

/* 故事部分 */
.story-section {
  background: var(--story-bg, #fff8e1);
  border-radius: 16rpx;
  padding: 24rpx;
  border-left: 6rpx solid #ffc107;
}

.dark-theme .story-section {
  background: var(--story-bg-dark, #3d3d2a);
}

.story-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #e65100;
  margin-bottom: 16rpx;
}

.story-content {
  font-size: 24rpx;
  color: #5d4037;
  line-height: 1.7;
}

/* 初衷部分 */
.purpose-section {
  background: var(--card-bg, #ffffff);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.dark-theme .purpose-section {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 4rpx 20rpx rgba(255, 255, 255, 0.08);
}

.purpose-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.purpose-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.purpose-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .purpose-title {
  color: var(--text-color-dark, #ffffff);
}

.purpose-content {
  
}

.purpose-text {
  font-size: 26rpx;
  color: var(--text-secondary, #495057);
  line-height: 1.6;
  margin-bottom: 30rpx;
  display: block;
}

.dark-theme .purpose-text {
  color: var(--text-secondary-dark, #aaaaaa);
}

.purpose-list {
  margin-bottom: 30rpx;
}

.purpose-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: var(--item-bg, #f8f9fa);
  border-radius: 12rpx;
}

.dark-theme .purpose-item {
  background: var(--item-bg-dark, #404040);
}

.purpose-bullet {
  font-size: 24rpx;
  margin-right: 16rpx;
  margin-top: 2rpx;
}

.purpose-desc {
  font-size: 24rpx;
  color: var(--text-secondary, #495057);
  line-height: 1.6;
  flex: 1;
}

.dark-theme .purpose-desc {
  color: var(--text-secondary-dark, #aaaaaa);
}

.purpose-footer {
  font-size: 26rpx;
  color: #667eea;
  line-height: 1.6;
  text-align: center;
  font-weight: 500;
  font-style: italic;
  padding: 20rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
  border-radius: 12rpx;
}
