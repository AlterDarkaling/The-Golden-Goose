<view class="report {{isDarkTheme ? 'dark-theme' : ''}}">
  <!-- Tab 导航 -->
  <view class="tab-nav">
    <view class="tab-item {{activeTab === 'daily-cost' ? 'active' : ''}}" bindtap="switchTab" data-tab="daily-cost">
      <text class="tab-icon">📉</text>
      <text class="tab-text">每日成本</text>
    </view>
    <view class="tab-item {{activeTab === 'assets' ? 'active' : ''}}" bindtap="switchTab" data-tab="assets">
      <text class="tab-icon">💎</text>
      <text class="tab-text">资产构成</text>
    </view>
    <view class="tab-item {{activeTab === 'debts' ? 'active' : ''}}" bindtap="switchTab" data-tab="debts">
      <text class="tab-icon">📋</text>
      <text class="tab-text">负债管理</text>
    </view>
    <view class="tab-item {{activeTab === 'health' ? 'active' : ''}}" bindtap="switchTab" data-tab="health">
      <text class="tab-icon">💚</text>
      <text class="tab-text">财务健康</text>
    </view>
  </view>

  <!-- ========== Tab 1: 每日成本 ========== -->
  <scroll-view wx:if="{{activeTab === 'daily-cost'}}" class="tab-content" scroll-y>
    <!-- 总卡片 -->
    <view class="hero-card">
      <text class="hero-label">综合日均成本</text>
      <text class="hero-value">¥{{dailyCostTotal}}</text>
      <text class="hero-hint">包含折旧、运营费用和贷款利息</text>
    </view>

    <!-- 趋势图 -->
    <view class="section">
      <text class="section-title">近6个月趋势</text>
      <view class="bar-chart">
        <view wx:for="{{dailyCostTrend}}" wx:key="month" class="bar-col">
          <view class="bar-track">
            <view class="bar-fill" style="height: {{item.barPercent}}%"></view>
          </view>
          <text class="bar-label">{{item.month}}</text>
          <text class="bar-value">{{item.valueText}}</text>
        </view>
      </view>
    </view>

    <!-- TOP5 消耗排行 -->
    <view class="section">
      <text class="section-title">消耗 TOP5</text>
      <view wx:if="{{topCostItems.length === 0}}" class="empty-hint">暂无消费资产数据</view>
      <view wx:for="{{topCostItems}}" wx:key="name" class="hbar-item">
        <view class="hbar-header">
          <text class="hbar-name">{{item.name}}</text>
          <text class="hbar-value">{{item.costText}}/天</text>
        </view>
        <view class="hbar-track">
          <view class="hbar-fill" style="width: {{item.barPercent}}%"></view>
        </view>
      </view>
    </view>

    <!-- 成本构成饼图 -->
    <view class="section">
      <text class="section-title">成本构成</text>
      <view wx:if="{{costPieLegend.length > 0}}" class="pie-row">
        <view class="pie-chart" style="{{costPieStyle}}"></view>
        <view class="pie-legend">
          <view wx:for="{{costPieLegend}}" wx:key="label" class="legend-item">
            <view class="legend-dot" style="background:{{item.color}}"></view>
            <text class="legend-label">{{item.label}}</text>
            <text class="legend-pct">{{item.percent}}</text>
            <text class="legend-val">{{item.valueText}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-hint">暂无成本数据</view>
    </view>
  </scroll-view>

  <!-- ========== Tab 2: 资产构成 ========== -->
  <scroll-view wx:if="{{activeTab === 'assets'}}" class="tab-content" scroll-y>
    <!-- 资产饼图 -->
    <view class="section">
      <text class="section-title">资产类型分布</text>
      <view wx:if="{{assetPieLegend.length > 0}}" class="pie-row">
        <view class="pie-chart" style="{{assetPieStyle}}"></view>
        <view class="pie-legend">
          <view wx:for="{{assetPieLegend}}" wx:key="label" class="legend-item">
            <view class="legend-dot" style="background:{{item.color}}"></view>
            <text class="legend-label">{{item.label}}</text>
            <text class="legend-pct">{{item.percent}}</text>
            <text class="legend-val">{{item.valueText}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-hint">暂无资产数据</view>
    </view>

    <!-- TOP5 资产 -->
    <view class="section">
      <text class="section-title">资产排行 TOP5</text>
      <view wx:if="{{topAssets.length === 0}}" class="empty-hint">暂无资产数据</view>
      <view wx:for="{{topAssets}}" wx:key="name" class="hbar-item">
        <view class="hbar-header">
          <text class="hbar-name">{{item.name}}</text>
          <text class="hbar-value">{{item.valueText}}</text>
        </view>
        <view class="hbar-track">
          <view class="hbar-fill asset-fill" style="width: {{item.barPercent}}%"></view>
        </view>
      </view>
    </view>

    <!-- 资产状态 -->
    <view class="section">
      <text class="section-title">资产状态</text>
      <view class="status-grid">
        <view wx:for="{{assetStatusItems}}" wx:key="name" class="status-card">
          <view class="status-dot" style="background:{{item.color}}"></view>
          <text class="status-count">{{item.count}}</text>
          <text class="status-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- ========== Tab 3: 负债管理 ========== -->
  <scroll-view wx:if="{{activeTab === 'debts'}}" class="tab-content" scroll-y>
    <!-- 总负债卡片 -->
    <view class="hero-card debt-hero">
      <text class="hero-label">总负债</text>
      <text class="hero-value">¥{{debtTotal}}</text>
      <view class="hero-row">
        <view class="hero-sub">
          <text class="hero-sub-label">月还款</text>
          <text class="hero-sub-value">¥{{debtMonthlyPayment}}</text>
        </view>
        <view class="hero-sub">
          <text class="hero-sub-label">月利息</text>
          <text class="hero-sub-value">¥{{debtTotalInterest}}</text>
        </view>
      </view>
    </view>

    <!-- 负债饼图 -->
    <view class="section">
      <text class="section-title">负债类型分布</text>
      <view wx:if="{{debtPieLegend.length > 0}}" class="pie-row">
        <view class="pie-chart" style="{{debtPieStyle}}"></view>
        <view class="pie-legend">
          <view wx:for="{{debtPieLegend}}" wx:key="label" class="legend-item">
            <view class="legend-dot" style="background:{{item.color}}"></view>
            <text class="legend-label">{{item.label}}</text>
            <text class="legend-pct">{{item.percent}}</text>
            <text class="legend-val">{{item.valueText}}</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty-hint">暂无负债数据</view>
    </view>

    <!-- 还款进度 -->
    <view class="section">
      <text class="section-title">还款进度</text>
      <view wx:if="{{debtItems.length === 0}}" class="empty-hint">暂无负债</view>
      <view wx:for="{{debtItems}}" wx:key="name" class="debt-card">
        <view class="debt-header">
          <text class="debt-name">{{item.name}}</text>
          <text class="debt-pct">{{item.progressPercent}}%</text>
        </view>
        <view class="progress-track">
          <view class="progress-fill" style="width: {{item.progressPercent}}%"></view>
        </view>
        <view class="debt-footer">
          <text class="debt-info">已还 {{item.paidText}} / {{item.totalText}}</text>
          <text class="debt-remain">{{item.remainMonthsText}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- ========== Tab 4: 财务健康 ========== -->
  <scroll-view wx:if="{{activeTab === 'health'}}" class="tab-content" scroll-y>
    <view class="section">
      <text class="section-title">健康指标</text>
      <view wx:if="{{healthMetrics.length === 0}}" class="empty-hint">暂无数据，请先添加资产和收入</view>
      <view wx:for="{{healthMetrics}}" wx:key="name" class="health-card">
        <view class="health-left">
          <view class="ring" style="border-color: #e0e0e0; border-top-color: {{item.ringColor}}; transform: rotate(-90deg)">
            <text class="ring-value">{{item.valueText}}</text>
          </view>
        </view>
        <view class="health-right">
          <text class="health-name">{{item.name}}</text>
          <text class="health-desc">{{item.desc}}</text>
          <view class="health-status {{item.status}}">
            <text class="status-text">{{item.advice}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>