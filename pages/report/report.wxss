.report-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 通用卡片样式 */
.overview-card,
.cashflow-card,
.category-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 30rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f8f9fa;
}

/* 财务概况 */
.overview-stats {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.stat-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  border-radius: 12rpx;
}

.stat-item.positive {
  background: linear-gradient(135deg, #e8f5e8 0%, #f0f8f0 100%);
}

.stat-item.negative {
  background: linear-gradient(135deg, #ffeaea 0%, #fff0f0 100%);
}

.stat-label {
  font-size: 26rpx;
  color: #6c757d;
  margin-bottom: 12rpx;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
}

.net-worth-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  color: white;
}

.net-worth-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
}

.net-worth-value {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.net-worth-value.positive {
  color: #51cf66;
}

.net-worth-value.negative {
  color: #ff6b6b;
}

/* 现金流分析 */
.cashflow-stats {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.cashflow-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.cashflow-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  border-radius: 12rpx;
}

.cashflow-item.income {
  background: #e8f5e8;
}

.cashflow-item.cost {
  background: #ffeaea;
}

.cashflow-label {
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 8rpx;
}

.cashflow-value {
  font-size: 32rpx;
  font-weight: bold;
}

.net-cashflow {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border-left: 6rpx solid #4A90E2;
}

.net-label {
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
}

.net-value {
  font-size: 36rpx;
  font-weight: bold;
}

.net-value.positive {
  color: #28a745;
}

.net-value.negative {
  color: #dc3545;
}

.projections {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.projection-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.projection-label {
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 8rpx;
}

.projection-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A90E2;
}

/* 分类分析 */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.category-item {
  position: relative;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.category-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.category-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #212529;
}

.category-details {
  display: flex;
  gap: 16rpx;
}

.category-count {
  font-size: 22rpx;
  color: #6c757d;
}

.category-percentage {
  font-size: 22rpx;
  color: #4A90E2;
  font-weight: bold;
}

.category-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 16rpx;
}

.progress-bar {
  height: 8rpx;
  background: #e9ecef;
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid #e9ecef;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.analysis-btn {
  background: #4A90E2;
  color: white;
}

.export-btn {
  background: #28a745;
  color: white;
}
