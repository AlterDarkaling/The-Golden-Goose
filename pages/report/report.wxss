/* 财务报告页面样式 */
.report-container {
  min-height: 100vh;
  background: var(--bg-gradient, linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%));
  padding-bottom: 40rpx;
  margin-top: -1rpx;
  padding-top: 1rpx;
}

.report-container.dark-theme {
  background: var(--bg-gradient-dark, linear-gradient(135deg, #1e1e1e 0%, #2d2d2d 100%));
  
  /* 深色主题变量 */
  --card-bg-dark: #2d2d2d;
  --text-color-dark: #ffffff;
  --text-secondary-dark: #aaaaaa;
  --text-tertiary-dark: #888888;
  --rate-bg-dark: #404040;
  --btn-bg-dark: #404040;
  --border-color-dark: #555555;
}

/* 报表导航 */
.report-nav {
  background: var(--card-bg, white);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}

.dark-theme .report-nav {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 2rpx 12rpx rgba(255, 255, 255, 0.1);
}

.nav-scroll {
  white-space: nowrap;
  padding: 20rpx 0;
}

.nav-item {
  display: inline-block;
  padding: 20rpx 30rpx;
  margin: 0 10rpx;
  border-radius: 30rpx;
  text-align: center;
  transition: all 0.3s ease;
  vertical-align: top;
}

.nav-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.3);
}

.nav-icon {
  display: block;
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.nav-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-color, #333);
}

.dark-theme .nav-text {
  color: var(--text-color-dark, #ffffff);
}

.dark-theme .nav-item.active .nav-text {
  color: white;
}

/* 时间段选择 */
.period-selector {
  display: flex;
  background: var(--card-bg, white);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.dark-theme .period-selector {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 4rpx 16rpx rgba(255, 255, 255, 0.08);
}

.period-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary, #666);
  transition: all 0.3s ease;
}

.dark-theme .period-item {
  color: var(--text-secondary-dark, #aaaaaa);
}

.period-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 报告内容 */
.report-content {
  padding: 0 20rpx;
}

/* 概览卡片 */
.overview-cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.overview-card {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
}

.dark-theme .overview-card {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.overview-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.main-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.main-card::before {
  background: rgba(255, 255, 255, 0.3);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .card-title {
  color: var(--text-color-dark, #ffffff);
}

.main-card .card-title {
  color: white;
}

.card-icon {
  font-size: 48rpx;
  opacity: 0.8;
}

.card-content {
  text-align: center;
}

.main-value {
  font-size: 56rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  display: block;
}

.main-value.positive {
  color: #4CAF50;
}

.main-value.negative {
  color: #F44336;
}

.main-card .main-value {
  color: white;
}

.sub-values {
  display: flex;
  justify-content: space-around;
}

.sub-item {
  text-align: center;
}

.sub-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
  margin-bottom: 8rpx;
}

.sub-value {
  font-size: 28rpx;
  font-weight: 600;
}

.sub-value.positive {
  color: #4CAF50;
}

.sub-value.negative {
  color: #F44336;
}

.main-card .sub-value {
  color: rgba(255, 255, 255, 0.9);
}

/* 财务健康度 */
.health-indicator {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .health-indicator {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.health-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.health-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .health-title {
  color: var(--text-color-dark, #ffffff);
}

.health-score {
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.health-score.excellent {
  background: var(--excellent-bg, #E8F5E8);
  color: #4CAF50;
}

.dark-theme .health-score.excellent {
  background: var(--excellent-bg-dark, #2a4a2a);
}

.health-score.good {
  background: var(--good-bg, #FFF3E0);
  color: #FF9800;
}

.dark-theme .health-score.good {
  background: var(--good-bg-dark, #4a3a1a);
}

.health-score.warning {
  background: var(--warning-bg, #FFEBEE);
  color: #F44336;
}

.dark-theme .health-score.warning {
  background: var(--warning-bg-dark, #4a2a2a);
}

.health-metrics {
  display: flex;
  justify-content: space-around;
}

.metric-item {
  text-align: center;
}

.metric-label {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary, #666);
  margin-bottom: 8rpx;
}

.dark-theme .metric-label {
  color: var(--text-secondary-dark, #aaaaaa);
}

.metric-value {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .metric-value {
  color: var(--text-color-dark, #ffffff);
}

/* 图表卡片 */
.chart-card {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .chart-card {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.chart-header {
  margin-bottom: 30rpx;
}

.chart-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .chart-title {
  color: var(--text-color-dark, #ffffff);
}

.chart-content {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.chart-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.chart-bar {
  flex: 1;
  height: 16rpx;
  background: var(--chart-bg, #f0f0f0);
  border-radius: 8rpx;
  overflow: hidden;
}

.dark-theme .chart-bar {
  background: var(--chart-bg-dark, #555);
}

.bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.6s ease;
}

.chart-info {
  display: flex;
  align-items: center;
  gap: 15rpx;
  min-width: 200rpx;
}

.chart-name {
  font-size: 26rpx;
  color: var(--text-color, #333);
  min-width: 80rpx;
}

.dark-theme .chart-name {
  color: var(--text-color-dark, #ffffff);
}

.chart-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #4CAF50;
  min-width: 60rpx;
}

.chart-percentage {
  font-size: 22rpx;
  color: var(--text-secondary, #666);
  min-width: 40rpx;
}

.dark-theme .chart-percentage {
  color: var(--text-secondary-dark, #aaaaaa);
}

/* 资产负债表 */
.balance-sheet {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .balance-sheet {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.balance-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .section-title {
  color: var(--text-color-dark, #ffffff);
}

.section-total {
  font-size: 36rpx;
  font-weight: 700;
  color: #4CAF50;
}

.section-total.negative {
  color: #F44336;
}

.section-total.positive {
  color: #4CAF50;
}

.balance-items {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.balance-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: var(--item-bg, #f8f9fa);
  border-radius: 12rpx;
}

.dark-theme .balance-item {
  background: var(--item-bg-dark, #404040);
}

.item-info {
  flex: 1;
}

.item-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-color, #333);
  display: block;
  margin-bottom: 6rpx;
}

.dark-theme .item-name {
  color: var(--text-color-dark, #ffffff);
}

.item-desc {
  font-size: 22rpx;
  color: var(--text-secondary, #666);
  font-style: italic;
}

.dark-theme .item-desc {
  color: var(--text-secondary-dark, #aaaaaa);
}

.item-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #4CAF50;
}

.item-value.negative {
  color: #F44336;
}

.balance-divider {
  height: 2rpx;
  background: var(--divider-color, #e0e0e0);
  margin: 30rpx 0;
}

.dark-theme .balance-divider {
  background: var(--divider-color-dark, #555);
}

.balance-divider.thick {
  height: 4rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.section-header.net-worth {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  border: none;
  margin: 0;
}

.net-worth .section-title,
.net-worth .section-total {
  color: white;
}

/* 利润表 */
.income-statement {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .income-statement {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.income-section {
  margin-bottom: 30rpx;
}

.income-items {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.income-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  background: var(--item-bg, #f8f9fa);
  border-radius: 10rpx;
}

.dark-theme .income-item {
  background: var(--item-bg-dark, #404040);
}

.income-divider {
  height: 2rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  margin: 30rpx 0;
}

.section-header.net-income {
  background: linear-gradient(135deg, #4CAF50 0%, #8BC34A 100%);
  color: white;
  padding: 30rpx;
  border-radius: 16rpx;
  border: none;
  margin: 0;
}

.net-income .section-title,
.net-income .section-total {
  color: white;
}

/* 饼图 */
.pie-charts {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-top: 30rpx;
}

.pie-chart {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .pie-chart {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.pie-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  margin-bottom: 20rpx;
  display: block;
}

.dark-theme .pie-title {
  color: var(--text-color-dark, #ffffff);
}

.pie-content {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.pie-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.pie-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.pie-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-color, #333);
}

.dark-theme .pie-name {
  color: var(--text-color-dark, #ffffff);
}

.pie-percentage {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary, #666);
}

.dark-theme .pie-percentage {
  color: var(--text-secondary-dark, #aaaaaa);
}

/* 现金流量表 */
.cashflow-statement {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .cashflow-statement {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.cashflow-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cashflow-item.total {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-radius: 16rpx;
  border: none;
  margin-top: 20rpx;
}

.cashflow-header {
  flex: 1;
}

.cashflow-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  display: block;
  margin-bottom: 6rpx;
}

.dark-theme .cashflow-title {
  color: var(--text-color-dark, #ffffff);
}

.cashflow-subtitle {
  font-size: 22rpx;
  color: var(--text-secondary, #666);
  font-style: italic;
}

.dark-theme .cashflow-subtitle {
  color: var(--text-secondary-dark, #aaaaaa);
}

.cashflow-value {
  font-size: 32rpx;
  font-weight: 700;
}

.cashflow-value.positive {
  color: #4CAF50;
}

.cashflow-value.negative {
  color: #F44336;
}

.cashflow-item.total .cashflow-title,
.cashflow-item.total .cashflow-subtitle,
.cashflow-item.total .cashflow-value {
  color: white;
}

.cashflow-divider {
  height: 2rpx;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx 0;
}

/* 趋势图表 */
.trend-chart {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .trend-chart {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.trend-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  margin-bottom: 30rpx;
  display: block;
}

.dark-theme .trend-title {
  color: var(--text-color-dark, #ffffff);
}

.trend-content {
  display: flex;
  justify-content: space-around;
  align-items: end;
  height: 300rpx;
  padding: 20rpx 0;
}

.trend-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
}

.bar-container {
  height: 200rpx;
  width: 40rpx;
  display: flex;
  align-items: end;
  position: relative;
}

.bar-fill {
  width: 100%;
  border-radius: 20rpx 20rpx 0 0;
  min-height: 10rpx;
  transition: height 0.6s ease;
}

.bar-fill.positive {
  background: linear-gradient(180deg, #4CAF50 0%, #8BC34A 100%);
}

.bar-fill.negative {
  background: linear-gradient(180deg, #F44336 0%, #FF7043 100%);
}

.bar-label {
  font-size: 22rpx;
  color: var(--text-secondary, #666);
}

.dark-theme .bar-label {
  color: var(--text-secondary-dark, #aaaaaa);
}

.bar-value {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .bar-value {
  color: var(--text-color-dark, #ffffff);
}

/* 财务分析 */
.ratio-analysis {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .ratio-analysis {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.analysis-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-color, #333);
  margin-bottom: 30rpx;
  display: block;
}

.dark-theme .analysis-title {
  color: var(--text-color-dark, #ffffff);
}

.ratio-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.ratio-item {
  text-align: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.ratio-item:active {
  border-color: #667eea;
  transform: scale(0.98);
}

.ratio-name {
  font-size: 24rpx;
  color: var(--text-secondary, #666);
  margin-bottom: 12rpx;
  display: block;
}

.dark-theme .ratio-name {
  color: var(--text-secondary-dark, #aaaaaa);
}

.ratio-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color, #333);
  margin-bottom: 8rpx;
  display: block;
}

.dark-theme .ratio-value {
  color: var(--text-color-dark, #ffffff);
}

.ratio-desc {
  font-size: 20rpx;
  color: var(--text-tertiary, #999);
  font-style: italic;
}

.dark-theme .ratio-desc {
  color: var(--text-tertiary-dark, #888888);
}

/* 折旧分析 */
.depreciation-analysis,
.loan-analysis {
  background: var(--card-bg, white);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .depreciation-analysis,
.dark-theme .loan-analysis {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 8rpx 32rpx rgba(255, 255, 255, 0.1);
}

.depreciation-list,
.loan-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.depreciation-item,
.loan-item {
  padding: 25rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border-left: 6rpx solid #667eea;
}

.depreciation-header,
.loan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.asset-name,
.loan-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color, #333);
}

.dark-theme .asset-name,
.dark-theme .loan-name {
  color: var(--text-color-dark, #ffffff);
}

.depreciation-rate,
.loan-rate {
  font-size: 22rpx;
  color: var(--text-secondary, #666);
  background: var(--rate-bg, #e9ecef);
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
}

.dark-theme .depreciation-rate,
.dark-theme .loan-rate {
  color: var(--text-secondary-dark, #aaaaaa);
  background: var(--rate-bg-dark, #404040);
}

.depreciation-values,
.loan-values {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15rpx;
}

.depreciation-value,
.loan-value {
  text-align: center;
}

.value-label {
  font-size: 22rpx;
  color: var(--text-secondary, #666);
  margin-bottom: 6rpx;
  display: block;
}

.dark-theme .value-label {
  color: var(--text-secondary-dark, #aaaaaa);
}

.value-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #4CAF50;
}

.value-amount.negative {
  color: #F44336;
}

/* 操作按钮 */
.action-section {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 20rpx;
  background: transparent;
}

.action-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 30rpx 20rpx;
  border-radius: 20rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
}

.action-btn.secondary {
  background: var(--btn-bg, white);
  color: var(--text-color, #333);
  border: 2rpx solid var(--border-color, #e0e0e0);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.dark-theme .action-btn.secondary {
  background: var(--btn-bg-dark, #404040);
  color: var(--text-color-dark, #ffffff);
  border: 2rpx solid var(--border-color-dark, #555555);
  box-shadow: 0 4rpx 16rpx rgba(255, 255, 255, 0.1);
}

.action-btn:active {
  transform: translateY(2rpx);
}

.btn-icon {
  font-size: 36rpx;
}

.btn-text {
  font-size: 26rpx;
  font-weight: 500;
}



/* 响应式适配 */
@media (max-width: 750rpx) {
  .ratio-grid {
    grid-template-columns: 1fr;
  }
  
  .depreciation-values,
  .loan-values {
    grid-template-columns: 1fr;
  }
  
  .trend-content {
    height: 250rpx;
  }
  
  .bar-container {
    height: 150rpx;
    width: 30rpx;
  }
  
  .action-section {
    flex-direction: column;
  }
  
  .action-btn {
    flex: none;
  }
}