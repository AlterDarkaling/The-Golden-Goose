/* ===== 全局 ===== */
.report { min-height: 100vh; background: var(--bg-color-primary, #f5f5f5); }
.report.dark-theme { --bg-color-primary: #121212; --bg-card: #1e1e1e; --text-primary: #fff; --text-secondary: #e0e0e0; --text-muted: #b3b3b3; --border: #333; }
.report:not(.dark-theme) { --bg-card: #fff; --text-primary: #212529; --text-secondary: #495057; --text-muted: #6c757d; --border: #e9ecef; }

/* ===== Tab 导航 ===== */
.tab-nav { display: flex; background: var(--bg-card); border-bottom: 1rpx solid var(--border); position: sticky; top: 0; z-index: 10; }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 20rpx 0; opacity: 0.6; }
.tab-item.active { opacity: 1; border-bottom: 4rpx solid #667eea; }
.tab-icon { font-size: 36rpx; margin-bottom: 4rpx; }
.tab-text { font-size: 22rpx; color: var(--text-secondary); }
.tab-item.active .tab-text { color: #667eea; font-weight: 600; }

/* ===== 内容区 ===== */
.tab-content { padding: 24rpx; box-sizing: border-box; overflow: hidden; width: 100%; }
.section { background: var(--bg-card); border-radius: 16rpx; padding: 28rpx; margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: var(--text-primary); margin-bottom: 24rpx; display: block; }
.empty-hint { text-align: center; color: var(--text-muted); font-size: 26rpx; padding: 40rpx 0; }

/* ===== Hero 卡片 ===== */
.hero-card { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 16rpx; padding: 36rpx; margin-bottom: 24rpx; text-align: center; color: #fff; }
.hero-card.debt-hero { background: linear-gradient(135deg, #f44336 0%, #e57373 100%); }
.hero-label { font-size: 26rpx; opacity: 0.85; display: block; margin-bottom: 8rpx; }
.hero-value { font-size: 52rpx; font-weight: 700; display: block; margin-bottom: 8rpx; }
.hero-hint { font-size: 22rpx; opacity: 0.7; display: block; }
.hero-row { display: flex; justify-content: center; gap: 48rpx; margin-top: 16rpx; }
.hero-sub { text-align: center; }
.hero-sub-label { font-size: 22rpx; opacity: 0.8; display: block; }
.hero-sub-value { font-size: 30rpx; font-weight: 600; display: block; }

/* ===== 柱状图（趋势） ===== */
.bar-chart { display: flex; align-items: flex-end; justify-content: space-between; height: 280rpx; gap: 12rpx; padding-top: 20rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.bar-track { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; }
.bar-fill { width: 60%; min-height: 4rpx; background: linear-gradient(to top, #667eea, #764ba2); border-radius: 4rpx 4rpx 0 0; transition: height 0.3s; }
.bar-label { font-size: 20rpx; color: var(--text-muted); margin-top: 8rpx; }
.bar-value { font-size: 18rpx; color: var(--text-secondary); }

/* ===== 横向条形图 ===== */
.hbar-item { margin-bottom: 20rpx; }
.hbar-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.hbar-name { font-size: 26rpx; color: var(--text-primary); }
.hbar-value { font-size: 26rpx; color: #667eea; font-weight: 600; }
.hbar-track { height: 16rpx; background: var(--border); border-radius: 8rpx; overflow: hidden; }
.hbar-fill { height: 100%; background: linear-gradient(90deg, #667eea, #764ba2); border-radius: 8rpx; transition: width 0.3s; }
.hbar-fill.asset-fill { background: linear-gradient(90deg, #4caf50, #81c784); }

/* ===== 饼图 ===== */
.pie-row { display: flex; align-items: center; gap: 32rpx; }
.pie-chart { width: 200rpx; height: 200rpx; border-radius: 50%; flex-shrink: 0; }
.pie-legend { flex: 1; }
.legend-item { display: flex; align-items: center; gap: 10rpx; margin-bottom: 12rpx; font-size: 24rpx; }
.legend-dot { width: 20rpx; height: 20rpx; border-radius: 50%; flex-shrink: 0; }
.legend-label { color: var(--text-primary); flex: 1; }
.legend-pct { color: var(--text-muted); width: 80rpx; text-align: right; }
.legend-val { color: var(--text-secondary); width: 140rpx; text-align: right; }

/* ===== 还款进度 ===== */
.debt-card { background: var(--bg-color-primary, #f5f5f5); border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.dark-theme .debt-card { background: #2d2d2d; }
.debt-header { display: flex; justify-content: space-between; margin-bottom: 10rpx; }
.debt-name { font-size: 28rpx; color: var(--text-primary); font-weight: 500; }
.debt-pct { font-size: 28rpx; color: #667eea; font-weight: 600; }
.progress-track { height: 14rpx; background: var(--border); border-radius: 7rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #4caf50, #81c784); border-radius: 7rpx; transition: width 0.3s; }
.debt-footer { display: flex; justify-content: space-between; margin-top: 10rpx; }
.debt-info { font-size: 22rpx; color: var(--text-muted); }
.debt-remain { font-size: 22rpx; color: var(--text-secondary); }

/* ===== 资产状态网格 ===== */
.status-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.status-card { display: flex; align-items: center; gap: 10rpx; background: var(--bg-color-primary, #f5f5f5); border-radius: 12rpx; padding: 16rpx 20rpx; min-width: 180rpx; }
.dark-theme .status-card { background: #2d2d2d; }
.status-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.status-count { font-size: 32rpx; font-weight: 700; color: var(--text-primary); }
.status-name { font-size: 24rpx; color: var(--text-muted); }

/* ===== 财务健康圆环 ===== */
.health-card { display: flex; align-items: center; gap: 24rpx; background: var(--bg-color-primary, #f5f5f5); border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.dark-theme .health-card { background: #2d2d2d; }
.health-left { flex-shrink: 0; }
.ring { width: 120rpx; height: 120rpx; border-radius: 50%; border-width: 10rpx; border-style: solid; display: flex; align-items: center; justify-content: center; }
.ring-value { font-size: 26rpx; font-weight: 700; color: var(--text-primary); transform: rotate(90deg); }
.health-right { flex: 1; }
.health-name { font-size: 30rpx; font-weight: 600; color: var(--text-primary); display: block; margin-bottom: 6rpx; }
.health-desc { font-size: 22rpx; color: var(--text-muted); display: block; margin-bottom: 10rpx; }
.health-status { border-radius: 8rpx; padding: 8rpx 12rpx; display: inline-block; }
.health-status.good { background: rgba(76, 175, 80, 0.15); }
.health-status.warn { background: rgba(255, 152, 0, 0.15); }
.health-status.bad { background: rgba(244, 67, 54, 0.15); }
.status-text { font-size: 22rpx; }
.health-status.good .status-text { color: #4caf50; }
.health-status.warn .status-text { color: #ff9800; }
.health-status.bad .status-text { color: #f44336; }