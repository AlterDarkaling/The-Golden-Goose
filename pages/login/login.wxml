<view class="welcome-container">
  <view class="logo-section">
    <view class="logo">🦢</view>
    <text class="app-name">会下金蛋的鹅</text>
    <text class="app-slogan">让钱为你工作</text>
  </view>

  <view class="content">
    <view class="welcome-section">
      <view class="welcome-title">欢迎使用会下金蛋的鹅</view>
      <view class="welcome-description">
        <text class="desc-line">基于《富爸爸穷爸爸》理念设计</text>
        <text class="desc-line">帮助您清晰区分资产与负债</text>
        <text class="desc-line">实现财务管理与财富增长</text>
      </view>
      
      <view class="features">
        <view class="feature-item">
          <text class="feature-icon">📊</text>
          <text class="feature-text">资产负债管理</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">💰</text>
          <text class="feature-text">净资产计算</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">📈</text>
          <text class="feature-text">收益成本分析</text>
        </view>
      </view>
    </view>

    <!-- 进入程序按钮 -->
    <view class="enter-section">
      <button class="enter-btn" bindtap="handleEnterApp">
        开始使用
      </button>
      <view class="enter-tip">数据存储在本地，安全可靠</view>
    </view>
  </view>
</view>