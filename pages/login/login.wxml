<view class="welcome-container">
  <view class="logo-section">
    <view class="logo">🦢</view>
    <text class="app-name">会下金蛋的鹅</text>
    <text class="app-slogan">让钱为你工作</text>
  </view>

  <view class="content">
    <view class="welcome-section">
      <view class="welcome-title">欢迎使用会下金蛋的鹅</view>
      <view class="welcome-description">
        <text class="desc-line">基于现代会计准则设计</text>
        <text class="desc-line">帮助您清晰区分资产与负债</text>
        <text class="desc-line">实现财务管理与财富增长</text>
      </view>
      
      <view class="features">
        <view class="feature-item">
          <text class="feature-icon">📊</text>
          <text class="feature-text">资产负债管理</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">💰</text>
          <text class="feature-text">净资产计算</text>
        </view>
        <view class="feature-item">
          <text class="feature-icon">📈</text>
          <text class="feature-text">收益成本分析</text>
        </view>
      </view>
    </view>

    <!-- 演示身份选择：后端按昵称签发 JWT，两个身份的云端数据互不可见 -->
    <view class="enter-section">
      <view class="identity-list">
        <view class="identity-item" wx:for="{{demoIdentities}}" wx:key="nickname"
              data-nickname="{{item.nickname}}" bindtap="handleEnterApp">
          <view class="identity-main">
            <text class="identity-name">{{item.nickname}}</text>
            <text class="identity-desc">{{item.desc}}</text>
          </view>
          <text class="identity-action">{{logging ? '登录中…' : '进入 →'}}</text>
        </view>
      </view>
      <view class="enter-tip">数据存于本地后端，不同登录身份之间完全隔离</view>
    </view>
  </view>
</view>