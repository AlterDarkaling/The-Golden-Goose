<view class="container">
  <!-- 个人信息栏 -->
  <view class="user-info-section">
    <view class="user-info-top">
      <view class="net-worth">
        <text class="net-worth-label">净资产</text>
        <text class="net-worth-value">¥{{netWorth}}</text>
      </view>
      <view class="avatar-container">
        <image 
          src="{{userInfo.avatar || '/static/default-avatar.png'}}" 
          class="avatar"
          mode="aspectFill"
          bindtap="chooseAvatar"
        />
      </view>
    </view>
    <view class="user-info-bottom">
      <view class="info-item">
        <text class="info-label">每日成本</text>
        <text class="info-value cost">¥{{dailyCost}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">资产数量</text>
        <text class="info-value">{{assetsCount}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">负债数量</text>
        <text class="info-value">{{liabilitiesCount}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">每日收益</text>
        <text class="info-value income">¥{{dailyIncome}}</text>
      </view>
    </view>
  </view>

  <!-- 功能栏 -->
  <view class="function-bar">
    <view class="search-container">
      <input 
        value="{{searchKeyword}}" 
        placeholder="搜索名称" 
        class="search-input"
        bindinput="onSearchInput"
      />
    </view>
    <view class="filter-container">
      <!-- 双栏排序选择器 -->
      <picker 
        mode="multiSelector"
        value="{{[sortFieldIndex, sortOrderIndex]}}"
        range="{{[sortFieldOptions, sortOrderOptions]}}"
        range-key="label"
        bindchange="onSortChange"
        class="filter-picker"
      >
        <view class="filter-item">
          <text>{{sortFieldIndex === 0 ? sortFieldOptions[sortFieldIndex].label : sortFieldOptions[sortFieldIndex].label + ' ' + sortOrderOptions[sortOrderIndex].label}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
      
      <!-- 分类选择 -->
      <picker 
        mode="multiSelector"
        value="{{categoryIndex}}" 
        range="{{[categoryLevelOne, categoryLevelTwo[categoryIndex[0]]]}}" 
        range-key="label"
        bindchange="onCategoryChange"
        bindcolumnchange="onCategoryColumnChange"
        class="filter-picker"
      >
        <view class="filter-item">
          <text>{{categoryIndex[0] === 0 ? categoryLevelOne[categoryIndex[0]].label : categoryLevelOne[categoryIndex[0]].label + ' ' + categoryLevelTwo[categoryIndex[0]][categoryIndex[1]].label}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
      
      <!-- 状态选择 -->
      <picker 
        value="{{statusIndex}}" 
        range="{{statusOptions}}" 
        range-key="label"
        bindchange="onStatusChange"
        class="filter-picker"
      >
        <view class="filter-item">
          <text>{{statusOptions[statusIndex].label}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 数据列表 -->
  <view class="data-section">
    <view class="data-list">
      <!-- 资产列表 -->
      <view wx:for="{{filteredAssets}}" wx:key="id" class="data-item asset-item" bindtap="viewDetail" data-item="{{item}}" data-type="asset">
        <view class="item-left">
          <view class="item-icon asset-icon">💰</view>
          <view class="item-info">
            <view class="item-name-row">
              <text class="item-name">{{item.name}}</text>
              <text class="item-type-tag asset-tag">{{item.typeText}}</text>
            </view>
            <text class="item-category">{{item.categoryName}}</text>
            <text class="item-purchase-date">{{item.createTimeText}}</text>
          </view>
        </view>
        <view class="item-right">
          <text class="item-amount">¥{{item.displayAmount}}</text>
          <text class="item-status {{item.status}}">{{item.statusText}}</text>
        </view>
      </view>

      <!-- 负债列表 -->
      <view wx:for="{{filteredLiabilities}}" wx:key="id" class="data-item liability-item" bindtap="viewDetail" data-item="{{item}}" data-type="liability">
        <view class="item-left">
          <view class="item-icon liability-icon">💳</view>
          <view class="item-info">
            <view class="item-name-row">
              <text class="item-name">{{item.name}}</text>
              <text class="item-type-tag liability-tag">{{item.typeText}}</text>
            </view>
            <text class="item-category">{{item.categoryName}}</text>
            <text class="item-purchase-date">{{item.createTimeText}}</text>
          </view>
        </view>
        <view class="item-right">
          <text class="item-amount">¥{{item.displayAmount}}</text>
          <text class="item-status {{item.status}}">{{item.statusText}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{filteredAssets.length === 0 && filteredLiabilities.length === 0}}" class="empty-state">
        <text class="empty-text">暂无数据</text>
        <text class="empty-hint">点击右下角按钮添加资产或负债</text>
      </view>
    </view>
  </view>
  
  <!-- 浮动添加按钮 -->
  <view class="float-btn" bindtap="handleFloatBtnClick">
    <text class="float-btn-icon">+</text>
  </view>
</view>
