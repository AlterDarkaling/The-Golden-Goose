<view class="container">
  <!-- 个人信息栏 -->
  <view class="user-info-section">
    <view class="user-info-top">
      <view class="net-worth">
        <text class="net-worth-label">净资产</text>
        <text class="net-worth-value">¥{{netWorth}}</text>
      </view>
      <view class="avatar-container" bindtap="chooseAvatar">
        <image 
          src="{{userInfo.avatar || '/static/default-avatar.svg'}}" 
          class="avatar"
          mode="aspectFill"
        />
      </view>
    </view>
    <!-- 现金流概览 -->
    <view class="cashflow-overview">
      <view class="cashflow-item positive">
        <text class="cashflow-label">月现金流入</text>
        <text class="cashflow-value">¥{{monthlyCashflowIn}}</text>
      </view>
      <view class="cashflow-item negative">
        <text class="cashflow-label">月现金流出</text>
        <text class="cashflow-value">¥{{monthlyCashflowOut}}</text>
      </view>
      <view class="cashflow-item {{netMonthlyCashflow >= 0 ? 'neutral' : 'warning'}}">
        <text class="cashflow-label">净月现金流</text>
        <text class="cashflow-value">¥{{netMonthlyCashflow}}</text>
      </view>
    </view>
    
    <view class="user-info-bottom">
      <view class="info-item">
        <text class="info-label">资产数量</text>
        <text class="info-value">{{assetsCount}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">负债数量</text>
        <text class="info-value">{{liabilitiesCount}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">现金流状态</text>
        <text class="info-value {{netMonthlyCashflow >= 0 ? 'positive' : 'negative'}}">{{cashflowStatus}}</text>
      </view>
    </view>
  </view>

  <!-- 功能栏 -->
  <view class="function-bar">
    <view class="search-container">
      <input 
        value="{{searchKeyword}}" 
        placeholder="搜索名称" 
        class="search-input"
        bindinput="onSearchInput"
      />
    </view>
    <view class="filter-container">
      <!-- 双栏排序选择器 -->
      <picker 
        mode="multiSelector"
        value="{{[sortFieldIndex, sortOrderIndex]}}"
        range="{{[sortFieldOptions, sortOrderOptions]}}"
        range-key="label"
        bindchange="onSortChange"
        class="filter-picker"
      >
        <view class="filter-item">
          <text>{{sortFieldIndex === 0 ? sortFieldOptions[sortFieldIndex].label : sortFieldOptions[sortFieldIndex].label + ' ' + sortOrderOptions[sortOrderIndex].label}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
      
      <!-- 分类选择 -->
      <picker 
        mode="multiSelector"
        value="{{categoryIndex}}" 
        range="{{[assetCategories, assetSubCategories[categoryIndex[0]]]}}" 
        range-key="label"
        bindchange="onCategoryChange"
        bindcolumnchange="onCategoryColumnChange"
        class="filter-picker"
      >
        <view class="filter-item">
          <text>{{categoryIndex[0] === 0 ? assetCategories[categoryIndex[0]].label : assetCategories[categoryIndex[0]].label + ' ' + assetSubCategories[categoryIndex[0]][categoryIndex[1]].label}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
      
      <!-- 状态选择：双栏选择器 -->
      <picker 
        mode="multiSelector"
        value="{{statusIndex}}" 
        range="{{[statusCategories, statusOptions[statusIndex[0]]]}}"
        range-key="label"
        bindchange="onStatusChange"
        bindcolumnchange="onStatusColumnChange"
        class="filter-picker"
      >
        <view class="filter-item">
          <text>{{statusOptions[statusIndex[0]][statusIndex[1]].label}}</text>
          <text class="filter-arrow">▼</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- 数据列表 -->
  <view class="data-section">
    <view class="data-list">
      <!-- 资产列表 -->
      <view wx:for="{{filteredAssets}}" wx:key="id" class="data-item asset-item" bindtap="viewDetail" data-item="{{item}}" data-type="asset">
        <view class="item-left">
          <view class="item-icon asset-icon">
            <image wx:if="{{item.logoType === 'image' && item.logoUrl}}"
                   src="{{item.logoUrl}}"
                   class="icon-image" />
            <text wx:elif="{{item.logoType === 'emoji' && item.logoEmoji}}"
                  class="icon-emoji">{{item.logoEmoji}}</text>
            <text wx:else class="icon-default">💰</text>
          </view>
          <view class="item-info">
            <view class="item-name-row">
              <text class="item-name">{{item.name}}</text>
              <text class="item-type-tag {{item.categoryL1 === 'work_income' ? 'income-tag' : 'asset-tag'}}">{{item.typeText}}</text>
            </view>
            <text class="item-category">{{item.categoryName}}</text>
            <text class="{{item.categoryL1 === 'work_income' ? 'item-start-date' : 'item-purchase-date'}}">{{item.createTimeText}}</text>
            <!-- 现金流信息 -->
            <view class="item-cashflow">
              <text wx:if="{{item.categoryL1 === 'work_income'}}" class="cashflow-label">月收入: </text>
              <text wx:elif="{{item.categoryL2 === 'consumer_assets'}}" class="cashflow-label">每日成本: </text>
              <text wx:else class="cashflow-label">月收入: </text>
              
              <text wx:if="{{item.categoryL1 === 'work_income'}}" class="cashflow-amount positive">¥{{item.monthlyIncome || '0'}}</text>
              <text wx:elif="{{item.categoryL2 === 'consumer_assets'}}" class="cashflow-amount negative">¥{{item.dailyCost || '0'}}</text>
              <text wx:else class="cashflow-amount positive">¥{{item.monthlyIncome || '0'}}</text>
            </view>
          </view>
        </view>
        <view class="item-right">
          <text class="item-amount">¥{{item.displayAmount}}</text>
          <text wx:if="{{item.categoryL1 !== 'work_income'}}" class="item-original-price">(¥{{item.originalPrice}})</text>
          <text class="item-status {{item.status}}">{{item.statusText}}</text>
        </view>
      </view>

      <!-- 负债列表 -->
      <view wx:for="{{filteredLiabilities}}" wx:key="id" class="data-item liability-item" bindtap="viewDetail" data-item="{{item}}" data-type="liability">
        <view class="item-left">
          <view class="item-icon liability-icon">
            <image wx:if="{{item.logoType === 'image' && item.logoUrl}}"
                   src="{{item.logoUrl}}"
                   class="icon-image" />
            <text wx:elif="{{item.logoType === 'emoji' && item.logoEmoji}}"
                  class="icon-emoji">{{item.logoEmoji}}</text>
            <text wx:else class="icon-default">💳</text>
          </view>
          <view class="item-info">
            <view class="item-name-row">
              <text class="item-name">{{item.name}}</text>
              <text class="item-type-tag liability-tag">{{item.typeText}}</text>
            </view>
            <text class="item-category">{{item.categoryName}}</text>
            <text class="item-borrow-date">{{item.createTimeText}}</text>
            <!-- 现金流信息 -->
            <view class="item-cashflow">
              <text class="cashflow-label">月支出: </text>
              <text class="cashflow-amount negative">¥{{item.monthlyPayment || '0'}}</text>
            </view>
          </view>
        </view>
        <view class="item-right">
          <text class="item-amount">¥{{item.displayAmount}}</text>
          <text class="item-original-price">(¥{{item.originalAmount}})</text>
          <text class="item-status {{item.status}}">{{item.statusText}}</text>
        </view>
      </view>

      <!-- 空状态 -->
      <view wx:if="{{filteredAssets.length === 0 && filteredLiabilities.length === 0}}" class="empty-state">
        <text class="empty-text">暂无数据</text>
        <text class="empty-hint">点击右下角按钮添加资产或负债</text>
      </view>
    </view>
  </view>
  
  <!-- 浮动添加按钮 -->
  <view class="float-btn" bindtap="handleFloatBtnClick">
    <text class="float-btn-icon">+</text>
  </view>

  <!-- 引导教程选择覆盖层 -->
  <view wx:if="{{showTutorialOverlay}}" class="tutorial-overlay">
    <view class="tutorial-welcome">
      <view class="welcome-header">
        <text class="welcome-icon">🎉</text>
        <text class="welcome-title">欢迎使用大鹅爱记账</text>
      </view>
      <view class="welcome-body">
        <text class="welcome-description">
          这是一款专业的个人财务管理工具，采用企业级会计准则帮您科学管理资产负债。
        </text>
        <text class="welcome-tip">
          当前显示的是演示数据，完成选择后演示数据将被自动清除：
        </text>
        <view class="welcome-options">
          <view class="option-item">
            <text class="option-icon">🎯</text>
            <text class="option-text">跟随引导教程，了解各项功能</text>
          </view>
          <view class="option-item">
            <text class="option-icon">🚀</text>
            <text class="option-text">直接开始使用，自由探索</text>
          </view>
        </view>
      </view>
      <view class="welcome-actions">
        <view class="welcome-btn secondary" bindtap="enterDirectly">
          直接进入
        </view>
        <view class="welcome-btn primary" bindtap="startTutorial">
          开始教程
        </view>
      </view>
    </view>
  </view>

  <!-- 引导教程步骤 -->
  <view wx:if="{{showTutorial}}" class="tutorial-guide">
    <!-- 教程遮罩 -->
    <view class="tutorial-mask"></view>
    
    <!-- 教程气泡 -->
    <view class="tutorial-bubble dynamic-position {{debugMode ? 'debug-mode' : ''}} {{bubbleVisible ? 'visible' : ''}}" 
          style="position: {{bubbleStyle.position || 'fixed'}}; left: {{bubbleStyle.left || 'auto'}}; top: {{bubbleStyle.top || 'auto'}}; bottom: {{bubbleStyle.bottom || 'auto'}}; right: {{bubbleStyle.right || 'auto'}}; transform: {{bubbleStyle.transform || 'none'}}; opacity: {{bubbleStyle.opacity || '0'}}; visibility: {{bubbleStyle.visibility || 'hidden'}};">
      <view class="bubble-header">
        <text class="bubble-title">{{currentTutorialStep.title}}</text>
        <view class="bubble-close" bindtap="skipTutorial">×</view>
      </view>
      <view class="bubble-content">
        <text class="bubble-text">{{currentTutorialStep.content}}</text>
      </view>
      <view class="bubble-footer">
        <view class="tutorial-progress">
          <text class="progress-text">{{tutorialStep + 1}} / {{tutorialSteps.length}}</text>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{(tutorialStep + 1) / tutorialSteps.length * 100}}%"></view>
          </view>
        </view>
        <view class="tutorial-actions">
          <view wx:if="{{tutorialStep > 0}}" class="tutorial-btn secondary" bindtap="prevTutorialStep">
            上一步
          </view>
          <view class="tutorial-btn primary" bindtap="nextTutorialStep">
            {{tutorialStep < tutorialSteps.length - 1 ? '下一步' : '完成'}}
          </view>
        </view>
      </view>
      <!-- 气泡箭头 -->
      <view class="bubble-arrow {{arrowClass || 'arrow-up'}}"></view>
    </view>
    
    <!-- 高亮目标元素（通过CSS实现） -->
    <view class="tutorial-highlight" data-target="{{currentTutorialStep.target}}"></view>
  </view>
</view>
