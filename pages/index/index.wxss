.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 个人信息栏 */
.user-info-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 40rpx;
  color: white;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.user-info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.net-worth {
  display: flex;
  flex-direction: column;
}

.net-worth-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.net-worth-value {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.avatar-container {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}



.avatar {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

/* 头像样式优化 */
.avatar {
  cursor: pointer;
  transition: all 0.3s ease;
}

.avatar:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.user-info-bottom {
  display: flex;
  justify-content: space-between;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.5);
}

.info-value.cost {
  color: #ff8a8a;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

.info-value.income {
  color: #69db7c;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

/* 功能栏 */
.function-bar {
  margin: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-container {
  margin-bottom: 30rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  border: none;
  box-sizing: border-box;
}

.filter-container {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.filter-picker {
  flex: 1;
  min-width: 140rpx;
}

/* 排序选择器样式优化 */
.sort-field-picker {
  flex: 1.2;
}

.sort-order-picker {
  flex: 0.8;
}



.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #495057;
  border: 1rpx solid #e9ecef;
}

.filter-arrow {
  font-size: 20rpx;
  color: #adb5bd;
}

/* 数据部分 */
.data-section {
  margin: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.add-buttons {
  display: flex;
  gap: 20rpx;
}

.add-btn {
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  border: none;
  color: white;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.asset-btn {
  background: #4caf50;
}

.liability-btn {
  background: #f44336;
}

/* 数据列表 */
.data-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.data-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  transition: all 0.3s ease;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.data-item:active {
  transform: scale(0.98);
  background: #e9ecef;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.icon-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.icon-emoji {
  font-size: 40rpx;
}

.icon-default {
  font-size: 40rpx;
}

.asset-icon {
  background: #e8f5e8;
}

.liability-icon {
  background: #ffeaea;
}

.item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.item-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
  flex: 1;
}

.item-type-tag {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  min-width: 60rpx;
  text-align: center;
}

.asset-tag {
  background: #E3F2FD;
  color: #1976D2;
}

.income-tag {
  background: #E8F5E8;
  color: #2E7D32;
}

.liability-tag {
  background: #FCE4EC;
  color: #C2185B;
}

.item-category {
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 6rpx;
}

.item-purchase-date {
  font-size: 22rpx;
  color: #adb5bd;
}

.item-start-date {
  font-size: 22rpx;
  color: #adb5bd;
}

.item-borrow-date {
  font-size: 22rpx;
  color: #adb5bd;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.item-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.item-original-price {
  font-size: 22rpx;
  color: #6c757d;
  margin-top: -4rpx;
}

.item-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  color: white;
}

.item-status.active {
  background: #28a745;
}

.item-status.dusty {
  background: #868e96;
}

.item-status.rented {
  background: #17a2b8;
}

.item-status.damaged {
  background: #dc3545;
}

.item-status.processed {
  background: #6f42c1;
}

.item-status.gifted {
  background: #fd7e14;
}

.item-status.sold {
  background: #20c997;
}

.item-status.lost {
  background: #495057;
}

/* 负债状态样式 */
.item-status.normal {
  background: #28a745;
}

.item-status.paid_off {
  background: #6c757d;
}

.item-status.overdue {
  background: #dc3545;
}

.item-status.prepaid {
  background: #007bff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #6c757d;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  opacity: 0.7;
}

/* 浮动添加按钮 */
.float-btn {
  position: fixed;
  bottom: max(80rpx, env(safe-area-inset-bottom, 40rpx) + 40rpx);
  right: max(40rpx, env(safe-area-inset-right, 20rpx) + 20rpx);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 100;
  margin: 0;
  transform: translateZ(0);
  backface-visibility: hidden;
}

.float-btn-icon {
  font-size: 60rpx;
  color: white;
  font-weight: bold;
  margin-bottom: 6rpx;
}

/* 现金流概览 */
.cashflow-overview {
  margin: 30rpx 0;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.cashflow-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.cashflow-item.positive {
  background: rgba(76, 175, 80, 0.3);
  border: 1rpx solid rgba(76, 175, 80, 0.4);
}

.cashflow-item.negative {
  background: rgba(244, 67, 54, 0.3);
  border: 1rpx solid rgba(244, 67, 54, 0.4);
}

.cashflow-item.neutral {
  background: rgba(33, 150, 243, 0.3);
  border: 1rpx solid rgba(33, 150, 243, 0.4);
}

.cashflow-item.warning {
  background: rgba(255, 152, 0, 0.3);
  border: 1rpx solid rgba(255, 152, 0, 0.4);
}

.cashflow-overview .cashflow-label {
  display: block;
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 8rpx;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.cashflow-overview .cashflow-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.4);
}

/* 状态颜色 */
.info-value.positive {
  color: #81c784;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

.info-value.negative {
  color: #e57373;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

/* 列表项现金流信息 */
.item-cashflow {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.item-cashflow .cashflow-label {
  font-size: 20rpx;
  color: #666666;
  margin-right: 8rpx;
}

.cashflow-amount {
  font-size: 22rpx;
  font-weight: 600;
}

.cashflow-amount.positive {
  color: #4caf50;
}

.cashflow-amount.negative {
  color: #f44336;
}

/* 引导教程系统 */
.tutorial-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.tutorial-welcome {
  background: #fff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  max-width: 640rpx;
  width: 100%;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  animation: tutorialFadeIn 0.4s ease-out;
}

@keyframes tutorialFadeIn {
  from {
    opacity: 0;
    transform: scale(0.9) translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.welcome-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.welcome-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
  display: block;
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.welcome-body {
  margin-bottom: 40rpx;
}

.welcome-description {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
  text-align: center;
}

.welcome-tip {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  text-align: center;
  margin-bottom: 24rpx;
}

.welcome-options {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 8rpx;
}

.option-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.option-item:last-child {
  margin-bottom: 0;
}

.option-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.option-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.4;
  flex: 1;
}

.welcome-actions {
  display: flex;
  gap: 20rpx;
}

.welcome-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.2s ease;
}

.welcome-btn.secondary {
  background: #f5f5f5;
  color: #666;
  border: 2rpx solid #e0e0e0;
}

.welcome-btn.secondary:active {
  background: #e0e0e0;
  transform: scale(0.98);
}

.welcome-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}

.welcome-btn.primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

/* 引导教程步骤 */
.tutorial-guide {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  pointer-events: none;
}

.tutorial-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.tutorial-bubble {
  position: fixed;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  max-width: min(600rpx, 90vw);
  min-width: min(400rpx, 70vw);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  z-index: 1002;
  pointer-events: auto;
  /* 初始状态完全隐藏 */
  opacity: 0;
  visibility: hidden;
  transform: translate(-50%, -50%) scale(0.8);
  transition: opacity 0.2s ease-out, visibility 0.2s ease-out, transform 0.2s ease-out;
  box-sizing: border-box;
  will-change: transform, opacity;
  transform: translateZ(0);
  backface-visibility: hidden;
}

/* 气泡显示状态 */
.tutorial-bubble.visible {
  opacity: 1;
  visibility: visible;
  animation: bubbleSlideIn 0.3s ease-out;
}

@keyframes bubbleSlideIn {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.9);
  }
  50% {
    opacity: 0.8;
    transform: translateY(10rpx) scale(0.95);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 气泡位置 */
.tutorial-bubble.center-top {
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
}

.tutorial-bubble.center-bottom {
  bottom: 25%;
  left: 50%;
  transform: translateX(-50%);
}

.tutorial-bubble.left-top {
  top: 30%;
  left: 40rpx;
  right: auto;
  transform: none;
}

.tutorial-bubble.right-top {
  top: 30%;
  right: 40rpx;
  left: auto;
  transform: none;
}

.tutorial-bubble.center-middle {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 兼容旧版本位置 */
.tutorial-bubble.bottom {
  bottom: 25%;
  left: 50%;
  transform: translateX(-50%);
}

.tutorial-bubble.top {
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
}

.bubble-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.bubble-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.bubble-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
  cursor: pointer;
}

.bubble-close:active {
  background: #e0e0e0;
}

.bubble-content {
  margin-bottom: 24rpx;
}

.bubble-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.bubble-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  min-height: 60rpx;
  gap: 20rpx;
  flex-wrap: nowrap;
}

.tutorial-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 1;
  min-width: 0;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  min-width: 80rpx;
}

.progress-bar {
  width: 120rpx;
  height: 6rpx;
  background: #e0e0e0;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.tutorial-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  flex-wrap: nowrap;
  overflow: hidden;
  max-width: 100%;
}

.tutorial-btn {
  display: inline-block;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  border: none;
  flex-shrink: 0;
  min-width: 120rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.tutorial-btn.secondary {
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #e0e0e0;
}

.tutorial-btn.secondary:active {
  background: #e0e0e0;
  transform: scale(0.96);
}

.tutorial-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.tutorial-btn.primary:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

/* 动态定位的气泡样式 */
.tutorial-bubble.dynamic-position {
  position: fixed !important;
  max-width: min(600rpx, 90vw);
  min-width: min(400rpx, 70vw);
  width: auto;
  z-index: 1002;
  box-sizing: border-box;
}

/* 气泡箭头 */
.bubble-arrow {
  position: absolute;
  width: 0;
  height: 0;
}

/* 向上箭头（气泡在目标下方） */
.bubble-arrow.arrow-up {
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 16rpx solid #fff;
  filter: drop-shadow(0 -2rpx 4rpx rgba(0, 0, 0, 0.1));
}

/* 向下箭头（气泡在目标上方） */
.bubble-arrow.arrow-down {
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #fff;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

/* 向左箭头（气泡在目标右侧） */
.bubble-arrow.arrow-left {
  left: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-right: 16rpx solid #fff;
}

/* 向右箭头（气泡在目标左侧） */
.bubble-arrow.arrow-right {
  right: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  border-top: 16rpx solid transparent;
  border-bottom: 16rpx solid transparent;
  border-left: 16rpx solid #fff;
}

/* 右下角箭头（特殊位置） */
.bubble-arrow.arrow-down-right {
  bottom: -16rpx;
  right: 40rpx;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #fff;
}

/* 左下角箭头（特殊位置） */
.bubble-arrow.arrow-down-left {
  bottom: -16rpx;
  left: 40rpx;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #fff;
}

/* 兼容旧版本箭头 */
.bubble-arrow.center-top,
.bubble-arrow.top {
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 16rpx solid #fff;
}

.bubble-arrow.center-bottom,
.bubble-arrow.bottom {
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #fff;
}

/* 目标元素高亮效果 */
.tutorial-highlight {
  position: absolute;
  pointer-events: none;
  z-index: 1000;
}

/* 高亮样式基础 */
.tutorial-guide .user-info-section,
.tutorial-guide .net-worth,
.tutorial-guide .cashflow-overview,
.tutorial-guide .user-info-bottom,
.tutorial-guide .function-bar,
.tutorial-guide .list-container {
  transition: all 0.3s ease;
}

/* 高亮样式 - 通过CSS选择器实现 */
.tutorial-guide .user-info-section {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
}

.tutorial-guide .net-worth {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 12rpx;
}

.tutorial-guide .cashflow-overview {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
}

.tutorial-guide .user-info-bottom {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 12rpx;
}

.tutorial-guide .function-bar {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
}

.tutorial-guide .list-container {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
}

.tutorial-guide .float-btn {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.4), 0 12rpx 40rpx rgba(102, 126, 234, 0.2);
  animation: tutorialPulse 2s infinite;
}

@keyframes tutorialPulse {
  0% {
    box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.4);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(102, 126, 234, 0.2);
  }
  100% {
    box-shadow: 0 0 0 6rpx rgba(102, 126, 234, 0.4);
  }
}

/* 调试模式样式 */
.tutorial-bubble.debug-mode {
  border: 3rpx solid #ff6b6b !important;
  background: linear-gradient(135deg, #fff9c4 0%, #f0f9ff 100%) !important;
}

.tutorial-bubble.debug-mode::before {
  content: "DEBUG";
  position: absolute;
  top: -24rpx;
  right: -24rpx;
  background: #ff6b6b;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  font-weight: bold;
  z-index: 10;
}

.tutorial-bubble.debug-mode .bubble-title {
  color: #d63031 !important;
  font-weight: bold;
}

.tutorial-bubble.debug-mode .bubble-text {
  color: #2d3436 !important;
}

