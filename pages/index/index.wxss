.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 个人信息栏 */
.user-info-section {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 40rpx;
  color: white;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  position: relative;
}

.user-info-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.net-worth {
  display: flex;
  flex-direction: column;
}

.net-worth-label {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 10rpx;
}

.net-worth-value {
  font-size: 56rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}

.avatar-container {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}



.avatar {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
}

/* 头像样式优化 */
.avatar {
  cursor: pointer;
  transition: all 0.3s ease;
}

.avatar:active {
  transform: scale(0.95);
  opacity: 0.8;
}

.user-info-bottom {
  display: flex;
  justify-content: space-between;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.info-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.info-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.5);
}

.info-value.cost {
  color: #ff8a8a;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

.info-value.income {
  color: #69db7c;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

/* 功能栏 */
.function-bar {
  margin: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-container {
  margin-bottom: 30rpx;
}

.search-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  border: none;
}

.filter-container {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.filter-picker {
  flex: 1;
  min-width: 140rpx;
}

/* 排序选择器样式优化 */
.sort-field-picker {
  flex: 1.2;
}

.sort-order-picker {
  flex: 0.8;
}



.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #495057;
  border: 1rpx solid #e9ecef;
}

.filter-arrow {
  font-size: 20rpx;
  color: #adb5bd;
}

/* 数据部分 */
.data-section {
  margin: 20rpx;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.section-header {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.add-buttons {
  display: flex;
  gap: 20rpx;
}

.add-btn {
  padding: 12rpx 20rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  border: none;
  color: white;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.asset-btn {
  background: #4caf50;
}

.liability-btn {
  background: #f44336;
}

/* 数据列表 */
.data-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.data-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-radius: 16rpx;
  background: #f8f9fa;
  transition: all 0.3s ease;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.data-item:active {
  transform: scale(0.98);
  background: #e9ecef;
}

.item-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.item-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.asset-icon {
  background: #e8f5e8;
}

.liability-icon {
  background: #ffeaea;
}

.item-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.item-name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  gap: 12rpx;
}

.item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #212529;
  flex: 1;
}

.item-type-tag {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 500;
  min-width: 60rpx;
  text-align: center;
}

.asset-tag {
  background: #E3F2FD;
  color: #1976D2;
}

.liability-tag {
  background: #FCE4EC;
  color: #C2185B;
}

.item-category {
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 6rpx;
}

.item-purchase-date {
  font-size: 22rpx;
  color: #adb5bd;
}

.item-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.item-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
}

.item-status {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  color: white;
}

.item-status.active {
  background: #28a745;
}

.item-status.dusty {
  background: #868e96;
}

.item-status.rented {
  background: #17a2b8;
}

.item-status.damaged {
  background: #dc3545;
}

.item-status.processed {
  background: #6f42c1;
}

.item-status.gifted {
  background: #fd7e14;
}

.item-status.sold {
  background: #20c997;
}

.item-status.lost {
  background: #495057;
}

/* 负债状态样式 */
.item-status.normal {
  background: #28a745;
}

.item-status.paid_off {
  background: #6c757d;
}

.item-status.overdue {
  background: #dc3545;
}

.item-status.prepaid {
  background: #007bff;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  color: #6c757d;
}

.empty-text {
  font-size: 32rpx;
  margin-bottom: 20rpx;
}

.empty-hint {
  font-size: 26rpx;
  opacity: 0.7;
}

/* 浮动添加按钮 */
.float-btn {
  position: fixed;
  bottom: 60rpx;
  right: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4A90E2;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.2);
  z-index: 100;
}

.float-btn-icon {
  font-size: 60rpx;
  color: white;
  font-weight: bold;
  margin-bottom: 6rpx;
}

/* 现金流概览 */
.cashflow-overview {
  margin: 30rpx 0;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.cashflow-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.cashflow-item.positive {
  background: rgba(76, 175, 80, 0.3);
  border: 1rpx solid rgba(76, 175, 80, 0.4);
}

.cashflow-item.negative {
  background: rgba(244, 67, 54, 0.3);
  border: 1rpx solid rgba(244, 67, 54, 0.4);
}

.cashflow-item.neutral {
  background: rgba(33, 150, 243, 0.3);
  border: 1rpx solid rgba(33, 150, 243, 0.4);
}

.cashflow-item.warning {
  background: rgba(255, 152, 0, 0.3);
  border: 1rpx solid rgba(255, 152, 0, 0.4);
}

.cashflow-overview .cashflow-label {
  display: block;
  font-size: 24rpx;
  color: #fff;
  margin-bottom: 8rpx;
  font-weight: 500;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.3);
}

.cashflow-overview .cashflow-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.4);
}

/* 状态颜色 */
.info-value.positive {
  color: #81c784;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

.info-value.negative {
  color: #e57373;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.6);
  font-weight: 700;
}

/* 列表项现金流信息 */
.item-cashflow {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.item-cashflow .cashflow-label {
  font-size: 20rpx;
  color: #666666;
  margin-right: 8rpx;
}

.cashflow-amount {
  font-size: 22rpx;
  font-weight: 600;
}

.cashflow-amount.positive {
  color: #4caf50;
}

.cashflow-amount.negative {
  color: #f44336;
}
