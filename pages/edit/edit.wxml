<!-- Logo选择底部弹窗 -->
<view class="bottom-modal-overlay {{showLogoModal ? 'show' : ''}}" bindtap="hideLogoSelector" catchtouchmove="">
  <view class="bottom-modal-content {{showLogoModal ? 'show' : ''}}" catchtap="">
    <!-- 顶部拖拽条 -->
    <view class="modal-drag-bar"></view>
    
    <!-- 标题区域 -->
    <view class="modal-header">
      <text class="modal-title">选择图标</text>
    </view>
    
    <!-- 选择方式标签 -->
    <view class="logo-type-tabs">
      <view class="tab-item {{logoSelectorType === 'emoji' ? 'active' : ''}}" 
            bindtap="switchLogoType" data-type="emoji">
        <text>表情符号</text>
      </view>
      <view class="tab-item {{logoSelectorType === 'image' ? 'active' : ''}}" 
            bindtap="switchLogoType" data-type="image">
        <text>上传图片</text>
      </view>
    </view>

    <!-- 内容区域 -->
    <view class="modal-body">
      <!-- Emoji选择 -->
      <view wx:if="{{logoSelectorType === 'emoji'}}" class="emoji-selector">
        <!-- 自定义输入按钮 -->
        <view class="custom-emoji-section">
          <button class="custom-input-btn" bindtap="showCustomEmojiInput">
            <text class="btn-icon">✏️</text>
            <text class="btn-text">输入自定义emoji</text>
          </button>
        </view>
        
        <!-- 预设emoji网格 -->
        <view class="preset-emojis">
          <text class="preset-label">选择预设图标：</text>
          
          <!-- 金融相关 -->
          <view class="emoji-category">
            <text class="category-title">💰 金融相关</text>
            <view class="emoji-grid">
              <view wx:for="{{emojiCategories.finance}}" wx:key="index" 
                    class="emoji-item {{formData.logoEmoji === item ? 'selected' : ''}}"
                    bindtap="selectEmoji" data-emoji="{{item}}">
                <text class="emoji-text">{{item}}</text>
              </view>
            </view>
          </view>
          
          <!-- 房产交通 -->
          <view class="emoji-category">
            <text class="category-title">🏠 房产交通</text>
            <view class="emoji-grid">
              <view wx:for="{{emojiCategories.property}}" wx:key="index" 
                    class="emoji-item {{formData.logoEmoji === item ? 'selected' : ''}}"
                    bindtap="selectEmoji" data-emoji="{{item}}">
                <text class="emoji-text">{{item}}</text>
              </view>
            </view>
          </view>
          
          <!-- 电子产品 -->
          <view class="emoji-category">
            <text class="category-title">📱 电子产品</text>
            <view class="emoji-grid">
              <view wx:for="{{emojiCategories.electronics}}" wx:key="index" 
                    class="emoji-item {{formData.logoEmoji === item ? 'selected' : ''}}"
                    bindtap="selectEmoji" data-emoji="{{item}}">
                <text class="emoji-text">{{item}}</text>
              </view>
            </view>
          </view>
          
          <!-- 服装配饰 -->
          <view class="emoji-category">
            <text class="category-title">👔 服装配饰</text>
            <view class="emoji-grid">
              <view wx:for="{{emojiCategories.fashion}}" wx:key="index" 
                    class="emoji-item {{formData.logoEmoji === item ? 'selected' : ''}}"
                    bindtap="selectEmoji" data-emoji="{{item}}">
                <text class="emoji-text">{{item}}</text>
              </view>
            </view>
          </view>
          
          <!-- 生活用品 -->
          <view class="emoji-category">
            <text class="category-title">🛏️ 生活用品</text>
            <view class="emoji-grid">
              <view wx:for="{{emojiCategories.lifestyle}}" wx:key="index" 
                    class="emoji-item {{formData.logoEmoji === item ? 'selected' : ''}}"
                    bindtap="selectEmoji" data-emoji="{{item}}">
                <text class="emoji-text">{{item}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 图片上传 -->
      <view wx:if="{{logoSelectorType === 'image'}}" class="image-selector">
        <view class="upload-area" bindtap="uploadImage">
          <image wx:if="{{formData.logoUrl}}" 
                 src="{{formData.logoUrl}}" 
                 class="preview-image" />
          <view wx:else class="upload-placeholder">
            <text class="upload-icon">📷</text>
            <text class="upload-text">点击上传图片</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部按钮 -->
    <view class="modal-footer">
      <button class="modal-btn cancel-btn" catchtap="cancelLogoSelector">取消</button>
      <button class="modal-btn confirm-btn" catchtap="confirmLogo">确定</button>
    </view>
  </view>
</view>

<!-- 薪资历史管理弹窗 -->
<view class="bottom-modal-overlay {{showSalaryHistoryModal ? 'show' : ''}}" bindtap="hideSalaryHistoryManager" catchtouchmove="">
  <view class="bottom-modal-content {{showSalaryHistoryModal ? 'show' : ''}}" catchtap="preventClose">
    <!-- 顶部拖拽条 -->
    <view class="modal-drag-bar"></view>
    
    <!-- 标题区域 -->
    <view class="modal-header">
      <text class="modal-title">薪资历史记录</text>
      <view class="modal-close-btn" catchtap="cancelSalaryHistoryManager">✕</view>
    </view>
    
    <!-- 内容区域 -->
    <view class="modal-body" catchtap="" catchtouchmove="" catchlongtap="">
      <!-- 薪资记录列表 -->
      <view class="salary-records-list" catchtap="" catchtouchmove="">
        <view wx:if="{{formData.salaryHistory.length === 0}}" class="empty-records">
          <text>暂无薪资记录</text>
        </view>
        <view wx:for="{{formData.salaryHistory}}" wx:key="id" class="salary-record-card" catchtap="" catchtouchmove="">
          <view class="record-main">
            <text class="record-reason">{{item.reason || '薪资调整'}}</text>
            <text class="record-amount">¥{{item.amount}}{{salaryUnitText}}</text>
          </view>
          <view class="record-actions">
            <text class="record-date">{{item.effectiveDate}}</text>
            <view class="record-btn-group">
              <view class="record-delete-btn" catchtap="deleteSalaryRecord" data-record-id="{{item.id}}" catchtouchmove="">删除</view>
            </view>
          </view>
        </view>
      </view>
      
      <!-- 添加新记录表单 -->
      <view class="add-salary-form" catchtap="" catchtouchmove="" catchlongtap="">
        <text class="form-section-title">添加薪资记录</text>
        
        <view class="form-row" catchtap="" catchtouchmove="">
          <view class="form-field" catchtap="" catchtouchmove="">
            <text class="field-label">生效日期</text>
            <picker mode="date" value="{{newSalaryRecord.effectiveDate}}" bindchange="onNewSalaryDateChange" class="field-picker" catchtap="" catchlongtap="" catchtouchstart="" catchtouchmove="" catchtouchend="" catchcancel="">
              <view class="picker-display" catchtap="" catchlongtap="" catchtouchstart="" catchtouchmove="" catchtouchend="">
                <text>{{newSalaryRecord.effectiveDate || '请选择日期'}}</text>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
        </view>
        
        <view class="form-row" catchtap="" catchtouchmove="">
          <view class="form-field" catchtap="" catchtouchmove="">
            <text class="field-label">{{salaryHistoryLabel}}</text>
            <input value="{{newSalaryRecord.amount}}" placeholder="{{salaryHistoryPlaceholder}}" class="field-input" type="digit" bindinput="onNewSalaryAmountInput" catchtap="" catchfocus="" catchblur="" catchtouchmove="" />
          </view>
          
          <view class="form-field" catchtap="" catchtouchmove="">
            <text class="field-label">变更原因</text>
            <input value="{{newSalaryRecord.reason}}" placeholder="如：入职、调薪、晋升" class="field-input" bindinput="onNewSalaryReasonInput" catchtap="" catchfocus="" catchblur="" catchtouchmove="" />
          </view>
        </view>
        
        <view class="add-salary-btn" catchtap="addSalaryRecord" catchtouchmove="">
          <text>添加记录</text>
        </view>
      </view>
    </view>
    
    <!-- 底部按钮 -->
    <view class="modal-footer">
      <button class="modal-btn confirm-btn" catchtap="confirmSalaryHistory">完成</button>
    </view>
  </view>
</view>
