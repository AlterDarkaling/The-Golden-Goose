            <text class="item-rate">18%/年</text>
          </view>
        </view>
      </view>
      
      <view class="depreciation-category">
        <text class="category-title">🚗 交通工具</text>
        <view class="depreciation-list">
          <view class="depreciation-item" bindtap="selectDepreciationRate" data-rate="12">
            <text class="item-name">家用汽车</text>
            <text class="item-rate">12%/年</text>
          </view>
          <view class="depreciation-item" bindtap="selectDepreciationRate" data-rate="20">
