.edit-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  background: white;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
}

.form-container {
  background: white;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 40rpx;
  position: relative;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.form-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #495057;
}

.picker-arrow {
  font-size: 20rpx;
  color: #adb5bd;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  font-size: 22rpx;
  color: #adb5bd;
}

.button-group {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 40rpx;
  border-top: 1rpx solid #e9ecef;
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.btn-cancel {
  background: #f8f9fa;
  color: #6c757d;
}

.btn-save {
  background: #4A90E2;
  color: white;
}

/* 类型选择 */
.type-selection {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  color: white;
}

.type-selection .form-label {
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.form-desc {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
  display: block;
}

.type-buttons {
  display: flex;
  gap: 20rpx;
}

.type-button {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s;
}

.type-button.active {
  background: rgba(255, 255, 255, 0.9);
  color: #333;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.type-button .type-desc {
  font-size: 22rpx;
  opacity: 0.8;
}

.type-button.active .type-desc {
  opacity: 0.6;
}

/* 选中类型显示 */
.selected-type {
  padding: 16rpx 0;
}

.type-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.type-tag.asset {
  background: #e8f5e8;
  color: #4caf50;
}

.type-tag.liability {
  background: #ffeaa7;
  color: #e17055;
}

/* 表单分组 */
.form-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border-left: 6rpx solid #667eea;
}

.cashflow-section {
  border-left-color: #26a69a;
  background: linear-gradient(135deg, rgba(38, 166, 154, 0.05) 0%, rgba(102, 126, 234, 0.05) 100%);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.section-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 24rpx;
  display: block;
  font-style: italic;
}

/* 消费性资产特有样式 */
.consumer-asset-section {
  border-left: 4rpx solid #fd7e14;
}

.depreciation-warning {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff3cd;
  border: 1rpx solid #ffeaa7;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.warning-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.warning-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.4;
  flex: 1;
}
