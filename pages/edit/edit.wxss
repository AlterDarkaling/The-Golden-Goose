.edit-container {
  min-height: 100vh;
  background: var(--bg-color-primary);
  padding-bottom: 120rpx;
  /* 修复导航栏底部白色边框 */
  margin-top: -1rpx;
  padding-top: 1rpx;
}

/* 深色主题容器 */
.edit-container.dark-theme {
  /* 背景色 */
  --bg-color-primary: #121212;
  --bg-color-secondary: #1e1e1e;
  --bg-color-tertiary: #2d2d2d;
  
  /* 文本色 */
  --text-color-primary: #ffffff;
  --text-color-secondary: #e0e0e0;
  --text-color-tertiary: #b3b3b3;
  --text-color-disabled: #666666;
  
  /* 边框色 */
  --border-color-light: #333333;
  --border-color-normal: #404040;
  --border-color-dark: #555555;
  
  /* 阴影 */
  --shadow-light: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  --shadow-normal: 0 4rpx 16rpx rgba(0, 0, 0, 0.4);
  --shadow-heavy: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
}

.header {
  background: var(--bg-color-secondary);
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid var(--border-color-light);
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-color-primary);
}

.form-container {
  background: var(--bg-color-secondary);
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 40rpx;
  box-shadow: var(--shadow-normal);
}

.form-group {
  margin-bottom: 40rpx;
  position: relative;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.form-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #495057;
}

.picker-arrow {
  font-size: 20rpx;
  color: #adb5bd;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.char-count {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  font-size: 22rpx;
  color: #adb5bd;
}

.button-group {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-color-secondary);
  padding: 20rpx 40rpx;
  border-top: 1rpx solid var(--border-color-light);
  display: flex;
  gap: 20rpx;
  z-index: 100;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.btn-cancel {
  background: #f8f9fa;
  color: #6c757d;
}

.btn-save {
  background: #4A90E2;
  color: white;
}

.btn:active {
  transform: scale(0.98);
  opacity: 0.8;
}

/* 类型选择 */
.type-selection {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
  color: white;
}

.type-selection .form-label {
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.form-desc {
  font-size: 24rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
  display: block;
}

.form-hint {
  font-size: 24rpx;
  color: #6c757d;
  margin-top: 8rpx;
  display: block;
}

.type-buttons {
  display: flex;
  gap: 20rpx;
}

.type-button {
  flex: 1;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  text-align: center;
  transition: all 0.3s;
}

.type-button.active {
  background: rgba(255, 255, 255, 0.9);
  color: #333;
}

.type-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.type-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.type-button .type-desc {
  font-size: 22rpx;
  opacity: 0.8;
}

.type-button.active .type-desc {
  opacity: 0.6;
}

/* 选中类型显示 */
.selected-type {
  padding: 16rpx 0;
}

.type-tag {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.type-tag.asset {
  background: #e8f5e8;
  color: #4caf50;
}

.type-tag.liability {
  background: #ffeaa7;
  color: #e17055;
}

/* 表单分组 */
.form-section {
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  border-left: 6rpx solid #667eea;
}

.cashflow-section {
  border-left-color: #26a69a;
  background: linear-gradient(135deg, rgba(38, 166, 154, 0.05) 0%, rgba(102, 126, 234, 0.05) 100%);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.section-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 24rpx;
  display: block;
  font-style: italic;
}



.depreciation-warning {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(255, 243, 205, 0.1);
  border: 1rpx solid rgba(255, 234, 167, 0.3);
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.warning-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.warning-text {
  font-size: 24rpx;
  color: #856404;
  line-height: 1.4;
  flex: 1;
}

/* 折旧率提示样式 */
.form-label-with-tip {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tip-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 20rpx;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.3);
}

.tip-btn:active {
  background: linear-gradient(135deg, #5a6fd8 0%, #6a4190 100%);
  transform: scale(0.95);
}

/* 折旧率参考弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--bg-color-secondary);
  border-radius: 16rpx;
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 24rpx;
  flex-shrink: 0;
}

/* 底部弹窗的标题样式 */
.bottom-modal-content .modal-header {
  border-bottom: 1rpx solid #f0f0f0;
  justify-content: space-between;
}

.modal-close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f8f9fa;
  color: #6c757d;
  font-size: 24rpx;
}

.modal-close-btn:active {
  background: #e9ecef;
  color: #495057;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  transition: all 0.3s ease;
}

.close-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.9);
}

.modal-body {
  padding: 0 24rpx;
  flex: 1;
  overflow-y: auto;
}

/* 底部弹窗的内容区域 */
.bottom-modal-content .modal-body {
  padding: 24rpx;
  max-height: 50vh;
}

.depreciation-category {
  margin-bottom: 40rpx;
}

.depreciation-category:last-child {
  margin-bottom: 0;
}

.category-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  display: block;
}

.depreciation-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.depreciation-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.depreciation-item:active {
  background: #e3f2fd;
  border-color: #2196f3;
  transform: scale(0.98);
}

.item-name {
  font-size: 28rpx;
  color: #333;
}

.item-rate {
  font-size: 28rpx;
  font-weight: bold;
  color: #2196f3;
}

.modal-footer {
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  gap: 16rpx;
  flex-shrink: 0;
}

/* 底部弹窗的按钮区域 */
.bottom-modal-content .modal-footer {
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-btn {
  background: #f8f9fa;
  color: #6c757d;
}

.confirm-btn {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
}

.modal-btn:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.footer-note {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
  text-align: center;
}

/* Logo选择器样式 */
.logo-selector {
  margin-top: 12rpx;
}

.current-logo {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  background: var(--bg-color-secondary);
  cursor: pointer;
}

.current-logo:active {
  background: #f8f9fa;
}

.logo-display {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #f8f9fa;
  border: 1rpx solid #e9ecef;
}

.logo-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.logo-emoji {
  font-size: 36rpx;
}

.logo-placeholder {
  font-size: 36rpx;
  opacity: 0.6;
}

.logo-tip {
  font-size: 26rpx;
  color: #6c757d;
}

/* 底部弹窗样式 */
.bottom-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.bottom-modal-overlay.show {
  opacity: 1;
  visibility: visible;
}

.bottom-modal-content {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--bg-color-secondary);
  border-radius: 24rpx 24rpx 0 0;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.bottom-modal-content.show {
  transform: translateY(0);
}

/* 拖拽条 */
.modal-drag-bar {
  width: 60rpx;
  height: 8rpx;
  background: #d6d8db;
  border-radius: 4rpx;
  margin: 16rpx auto 8rpx;
  flex-shrink: 0;
}

.logo-type-tabs {
  display: flex;
  margin: 0 24rpx 24rpx;
  border-radius: 8rpx;
  background: #f8f9fa;
  padding: 4rpx;
  flex-shrink: 0;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 6rpx;
  font-size: 26rpx;
  cursor: pointer;
}

.tab-item.active {
  background: var(--bg-color-secondary);
  color: #4facfe;
  font-weight: bold;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.emoji-selector {
  max-height: 500rpx;
  overflow-y: scroll;
}

/* 自定义emoji按钮样式 */
.custom-emoji-section {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #e9ecef;
}

.custom-input-btn {
  width: 100%;
  height: 80rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  border: none;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.custom-input-btn:active {
  transform: scale(0.98);
  opacity: 0.8;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  font-size: 28rpx;
}

.preset-label {
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 12rpx;
  display: block;
  font-weight: 500;
}

.preset-emojis {
  margin-top: 8rpx;
}

.emoji-category {
  margin-bottom: 32rpx;
}

.emoji-category:last-child {
  margin-bottom: 0;
}

.category-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.emoji-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 16rpx;
}

.emoji-item {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: #f8f9fa;
  cursor: pointer;
}

.emoji-item:active {
  background: #e9ecef;
}

.emoji-item.selected {
  border-color: #4facfe;
  background: rgba(79, 172, 254, 0.1);
}

.emoji-text {
  font-size: 32rpx;
}

.image-selector {
  display: flex;
  justify-content: center;
}

.upload-area {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #d0d7de;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  cursor: pointer;
}

.upload-area:active {
  background: #f8f9fa;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.upload-icon {
  font-size: 48rpx;
  opacity: 0.6;
}

.upload-text {
  font-size: 24rpx;
  color: #6c757d;
}

/* 工作价值预览样式 */
.work-value-preview {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: 24rpx;
  border-left: 4rpx solid #007bff;
}

.preview-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #007bff;
  margin-bottom: 16rpx;
  display: block;
}

.preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #6c757d;
}

.preview-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #212529;
}

/* 薪资历史管理样式 */
.form-label-with-action {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.manage-btn {
  background: #007bff;
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  cursor: pointer;
}

.manage-btn:active {
  background: #0056b3;
}

.salary-history-preview {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e9ecef;
}

.empty-history {
  text-align: center;
  color: #6c757d;
  font-size: 26rpx;
  padding: 20rpx 0;
}

.salary-record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e9ecef;
}

.salary-record-item:last-child {
  border-bottom: none;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-reason {
  font-size: 26rpx;
  color: #495057;
  margin-bottom: 4rpx;
}

.record-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #007bff;
}

.record-date {
  font-size: 24rpx;
  color: #6c757d;
}

/* 薪资历史弹窗样式 */
.salary-records-list {
  margin-bottom: 40rpx;
}

.empty-records {
  text-align: center;
  color: #6c757d;
  font-size: 28rpx;
  padding: 40rpx 0;
}

.salary-record-card {
  background: var(--bg-color-secondary);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #e9ecef;
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.record-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-btn-group {
  display: flex;
  gap: 16rpx;
}

.record-delete-btn {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  cursor: pointer;
  background: #f8d7da;
  color: #721c24;
}

.record-delete-btn:active {
  background: #f1b0b7;
}

/* 添加薪资表单样式 */
.add-salary-form {
  border-top: 2rpx solid #e9ecef;
  padding-top: 30rpx;
}

.form-section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #495057;
  margin-bottom: 20rpx;
  display: block;
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-field {
  flex: 1;
}

.field-label {
  font-size: 24rpx;
  color: #495057;
  margin-bottom: 8rpx;
  display: block;
}

.field-input {
  width: 100%;
  height: 60rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  border: 1rpx solid #e9ecef;
}

.field-picker {
  width: 100%;
}

.field-picker .picker-display {
  height: 60rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
  border: 1rpx solid #e9ecef;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-salary-btn {
  background: #28a745;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  text-align: center;
  margin-top: 20rpx;
  cursor: pointer;
}

.add-salary-btn:active {
  background: #1e7e34;
}

/* 教程样式 */
.tutorial-guide {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
  pointer-events: auto;
}

.tutorial-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  pointer-events: auto;
}

.tutorial-bubble {
  position: fixed;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  max-width: min(600rpx, 90vw);
  min-width: min(400rpx, 70vw);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  z-index: 1002;
  pointer-events: auto;
  animation: bubbleSlideIn 0.3s ease-out;
  box-sizing: border-box;
  will-change: transform, opacity;
  transform: translateZ(0);
  backface-visibility: hidden;
}

@keyframes bubbleSlideIn {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.9);
  }
  50% {
    opacity: 0.8;
    transform: translateY(10rpx) scale(0.95);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.bubble-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.bubble-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.bubble-close {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
  cursor: pointer;
}

.bubble-content {
  margin-bottom: 24rpx;
}

.bubble-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  white-space: pre-wrap;
}

.bubble-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
  min-height: 60rpx;
  gap: 20rpx;
  flex-wrap: nowrap;
}

.tutorial-progress {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 1;
  min-width: 0;
}

.progress-text {
  font-size: 24rpx;
  color: #999;
  min-width: 80rpx;
}

.progress-bar {
  width: 120rpx;
  height: 6rpx;
  background: #e0e0e0;
  border-radius: 3rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.tutorial-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  flex-wrap: nowrap;
  overflow: hidden;
  max-width: 100%;
}

.tutorial-btn {
  display: inline-block;
  padding: 16rpx 24rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  text-align: center;
  cursor: pointer;
  border: none;
  flex-shrink: 0;
  min-width: 120rpx;
  white-space: nowrap;
  transition: all 0.2s ease;
}

.tutorial-btn.secondary {
  background: #f5f5f5;
  color: #666;
  border: 1rpx solid #e0e0e0;
}

.tutorial-btn.secondary:active {
  background: #e0e0e0;
  transform: scale(0.96);
}

.tutorial-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.tutorial-btn.primary:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(102, 126, 234, 0.4);
}

/* 气泡箭头 */
.bubble-arrow {
  position: absolute;
  width: 0;
  height: 0;
}

/* 向上箭头（气泡在目标下方） */
.bubble-arrow.arrow-up {
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 16rpx solid #fff;
  filter: drop-shadow(0 -2rpx 4rpx rgba(0, 0, 0, 0.1));
}

/* 向下箭头（气泡在目标上方） */
.bubble-arrow.arrow-down {
  bottom: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 16rpx solid #fff;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.1));
}

/* 教程高亮样式 */
.tutorial-guide .type-selection {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
  animation: tutorialPulse 2s infinite;
}

.tutorial-guide .form-section {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
  animation: tutorialPulse 2s infinite;
}

.tutorial-guide .form-group {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
  animation: tutorialPulse 2s infinite;
}

.tutorial-guide .button-group {
  position: relative;
  z-index: 1001;
  box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.3), 0 8rpx 32rpx rgba(102, 126, 234, 0.1);
  border-radius: 16rpx;
  animation: tutorialPulse 2s infinite;
}

@keyframes tutorialPulse {
  0% {
    box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.4);
  }
  50% {
    box-shadow: 0 0 0 12rpx rgba(102, 126, 234, 0.2);
  }
  100% {
    box-shadow: 0 0 0 4rpx rgba(102, 126, 234, 0.4);
  }
}
