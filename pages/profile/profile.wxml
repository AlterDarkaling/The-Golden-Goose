<view class="profile-container">
  <!-- 头部用户信息卡片 -->
  <view class="user-card {{showTutorial && tutorialStep === 0 ? 'tutorial-highlight' : ''}}">
    <view class="user-header">
      <view class="avatar-container">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <image 
            src="{{displayInfo.avatar || '/static/default-avatar.svg'}}" 
            class="user-avatar"
            mode="aspectFill"
          />
        </button>
      </view>
      <view class="user-info">
        <view class="nickname-container">
          <text class="username" bindtap="chooseNickname" bindlongpress="showDeveloperOptions">{{displayInfo.nickname || '大鹅爱记账用户'}}</text>
          <!-- 隐藏的微信原生昵称输入，用于直接触发微信昵称选择 -->
          <input 
            type="nickname" 
            class="hidden-nickname-input"
            style="position: absolute; left: -9999px; opacity: 0; width: 1px; height: 1px;"
            bind:input="onDirectNicknameChange"
            id="hiddenNicknameInput"
            wx:if="{{showHiddenNicknameInput}}"
            focus="{{showHiddenNicknameInput}}"
          />
        </view>
        <text class="user-motto" bindtap="changeMotto">{{displayInfo.motto || '理财从认识资产负债开始'}}</text>
      </view>
    </view>
    
    <!-- 昵称输入弹窗 -->
    <view class="nickname-input-modal" wx:if="{{showNicknameInput}}">
      <view class="modal-mask" bindtap="closeNicknameInput"></view>
      <view class="modal-content">
        <view class="modal-header">
          <text class="modal-title">设置昵称</text>
          <view class="modal-close" bindtap="closeNicknameInput">×</view>
        </view>
        <view class="modal-body">
          <input 
            type="nickname" 
            class="nickname-input" 
            placeholder="点击输入框可自动填充微信昵称"
            value="{{tempNickname}}"
            bind:input="onTempNicknameInput"
            bind:blur="onNicknameBlur"
            bind:focus="onNicknameFocus"
            focus="{{showNicknameInput}}"
            maxlength="20"
          />
        </view>
        <view class="modal-footer">
          <button class="cancel-btn" bindtap="closeNicknameInput">取消</button>
          <button class="confirm-btn" bindtap="confirmNickname">确定</button>
        </view>
      </view>
    </view>
    
    <!-- 个人签名输入弹窗 -->
    <view class="motto-input-modal" wx:if="{{showMottoInput}}">
      <view class="modal-mask" bindtap="closeMottoInput"></view>
      <view class="modal-content">
        <view class="modal-header">
          <text class="modal-title">设置个人签名</text>
          <view class="modal-close" bindtap="closeMottoInput">×</view>
        </view>
        <view class="modal-body">
          <input 
            class="motto-input" 
            placeholder="输入你的理财格言"
            value="{{tempMotto}}"
            bind:input="onTempMottoInput"
            focus="{{showMottoInput}}"
          />
        </view>
        <view class="modal-footer">
          <button class="cancel-btn" bindtap="closeMottoInput">取消</button>
          <button class="confirm-btn" bindtap="confirmMotto">确定</button>
        </view>
      </view>
    </view>
    
    <!-- 统计数据 -->
    <view class="stats-container {{showTutorial && tutorialStep === 1 ? 'tutorial-highlight' : ''}}">
      <view class="stat-item">
        <text class="stat-number">{{stats.usageDays}}</text>
        <text class="stat-label">使用天数</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.netWorth}}</text>
        <text class="stat-label">净资产</text>
      </view>
      <view class="stat-item">
        <text class="stat-number">{{stats.assetCount}}</text>
        <text class="stat-label">记录数量</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-grid {{showTutorial && tutorialStep === 2 ? 'tutorial-highlight' : ''}}">
      <view class="menu-item" bindtap="handleFinancialReport">
        <view class="menu-icon">📊</view>
        <text class="menu-label">财务报告</text>
      </view>
      <view class="menu-item" bindtap="handleDreamJar">
        <view class="menu-icon">🏆</view>
        <text class="menu-label">梦想储蓄罐</text>
      </view>
      <view class="menu-item" bindtap="handleDataBackup">
        <view class="menu-icon">💾</view>
        <text class="menu-label">数据备份</text>
      </view>
      <view class="menu-item" bindtap="handleDataRestore">
        <view class="menu-icon">📥</view>
        <text class="menu-label">数据恢复</text>
      </view>

    </view>
  </view>

  <!-- 功能列表 -->
  <view class="settings-section {{showTutorial && tutorialStep === 3 ? 'tutorial-highlight' : ''}}">
    <view class="setting-item" bindtap="handleAboutBooks">
      <view class="setting-left">
        <view class="setting-icon">📚</view>
        <view class="setting-content">
          <text class="setting-title">理财启蒙</text>
          <text class="setting-desc">了解现代财务管理理念和会计知识</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="handleTutorialReview">
      <view class="setting-left">
        <view class="setting-icon">🎯</view>
        <view class="setting-content">
          <text class="setting-title">功能引导</text>
          <text class="setting-desc">重新查看应用功能介绍和使用教程</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="handleFeedback">
      <view class="setting-left">
        <view class="setting-icon">👥</view>
        <view class="setting-content">
          <text class="setting-title">意见反馈</text>
          <text class="setting-desc">目前还是测试版</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>

    <view class="setting-item" bindtap="handleClearData">
      <view class="setting-left">
        <view class="setting-icon">🗑️</view>
        <view class="setting-content">
          <text class="setting-title">清空数据</text>
          <text class="setting-desc">清空全部资产记录，无法恢复</text>
        </view>
      </view>
      <text class="setting-arrow">></text>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- 个人中心引导教程 -->
  <view wx:if="{{showTutorial}}" class="tutorial-guide">
    <!-- 教程遮罩 -->
    <view class="tutorial-mask"></view>
    
    <!-- 教程气泡 -->
    <view class="tutorial-bubble dynamic-position {{bubbleVisible ? 'visible' : ''}}" 
          style="position: {{bubbleStyle.position || 'fixed'}}; left: {{bubbleStyle.left || 'auto'}}; top: {{bubbleStyle.top || 'auto'}}; bottom: {{bubbleStyle.bottom || 'auto'}}; right: {{bubbleStyle.right || 'auto'}}; transform: {{bubbleStyle.transform || 'none'}}; opacity: {{bubbleStyle.opacity || '0'}}; visibility: {{bubbleStyle.visibility || 'hidden'}};">
      <view class="bubble-header">
        <text class="bubble-title">{{currentTutorialStep.title}}</text>
        <view class="bubble-close" bindtap="skipTutorial">×</view>
      </view>
      <view class="bubble-content">
        <text class="bubble-text">{{currentTutorialStep.content}}</text>
      </view>
      <view class="bubble-footer">
        <view class="tutorial-progress">
          <text class="progress-text">{{tutorialStep + 1}} / {{tutorialSteps.length}}</text>
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{(tutorialStep + 1) / tutorialSteps.length * 100}}%"></view>
          </view>
        </view>
        <view class="tutorial-actions">
          <view wx:if="{{tutorialStep > 0}}" class="tutorial-btn secondary" bindtap="prevTutorialStep">上一步</view>
          <view wx:if="{{tutorialStep < tutorialSteps.length - 1}}" class="tutorial-btn primary" bindtap="nextTutorialStep">下一步</view>
          <view wx:if="{{tutorialStep === tutorialSteps.length - 1}}" class="tutorial-btn primary" bindtap="completeProfileTutorial">完成</view>
        </view>
      </view>
      
      <!-- 箭头指示器 -->
      <view class="bubble-arrow {{arrowClass}}"></view>
    </view>
  </view>
</view>
