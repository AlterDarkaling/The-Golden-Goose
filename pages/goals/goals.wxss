.goals-container {
  min-height: 100vh;
  background-color: var(--bg-color, #f5f5f5);
  padding: 20rpx;
  padding-bottom: 120rpx;
  margin-top: -1rpx;
  padding-top: 21rpx;
}

.goals-container.dark-theme {
  background-color: var(--bg-color-dark, #1e1e1e);
}

/* 目标列表 */
.goals-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.goal-item {
  background: var(--card-bg, white);
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.dark-theme .goal-item {
  background: var(--card-bg-dark, #2d2d2d);
  box-shadow: 0 4rpx 16rpx rgba(255, 255, 255, 0.05);
}

.goal-item:active {
  transform: scale(0.98);
}

.goal-item.completed {
  background: linear-gradient(135deg, #e8f5e8 0%, #f0f8f0 100%);
  border-left: 6rpx solid #28a745;
}

.goal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.goal-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.goal-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.goal-details {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.goal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color, #212529);
  margin-bottom: 8rpx;
  line-height: 1.3;
}

.dark-theme .goal-title {
  color: var(--text-color-dark, #ffffff);
}

.goal-category {
  font-size: 24rpx;
  color: var(--text-secondary, #6c757d);
}

.dark-theme .goal-category {
  color: var(--text-secondary-dark, #aaaaaa);
}

.goal-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.current-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #28a745;
}

.target-amount {
  font-size: 24rpx;
  color: var(--text-secondary, #6c757d);
}

.dark-theme .target-amount {
  color: var(--text-secondary-dark, #aaaaaa);
}

/* 进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #e9ecef;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2 0%, #28a745 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: bold;
  min-width: 80rpx;
  text-align: right;
}

/* 储蓄建议 */
.savings-advice {
  background: linear-gradient(135deg, #fff9e6 0%, #fffbf0 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-left: 4rpx solid #ffc107;
}

.advice-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 10rpx;
}

.advice-icon {
  font-size: 24rpx;
}

.advice-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #856404;
  flex: 1;
}

.priority-tag {
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.priority-tag.urgent {
  background: #f8d7da;
  color: #721c24;
}

.priority-tag.high {
  background: #fff3cd;
  color: #856404;
}

.priority-tag.normal {
  background: #d1ecf1;
  color: #0c5460;
}

.advice-content {
  display: flex;
  gap: 30rpx;
  margin-bottom: 16rpx;
}

.advice-item {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.advice-label {
  font-size: 22rpx;
  color: #856404;
}

.advice-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #212529;
}

.suggestions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.suggestion-text {
  font-size: 22rpx;
  color: #856404;
  line-height: 1.4;
}

/* 目标底部 */
.goal-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-top: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.deadline {
  font-size: 20rpx;
  color: #6c757d;
  font-weight: normal;
  margin-left: 8rpx;
}

.deadline.urgent {
  color: #ffc107;
  font-weight: bold;
}

.deadline.expired {
  color: #dc3545;
  font-weight: bold;
}

.goal-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
  flex-wrap: nowrap;
  width: 100%;
  justify-content: space-between;
  align-items: center;
}

.action-btn {
  flex: 1;
  padding: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  text-align: center;
  white-space: nowrap;
  height: 80rpx;
  color: white;
  transition: all 0.3s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.advice-btn {
  background: linear-gradient(135deg, #e6b800 0%, #d9aa00 100%);
  color: white;
}

.advice-btn:active {
  background: linear-gradient(135deg, #d9aa00 0%, #cc9900 100%);
  transform: translateY(2rpx);
}

.update-btn {
  background: linear-gradient(135deg, #6b9bd1 0%, #5a89c4 100%);
  color: white;
}

.update-btn:active {
  background: linear-gradient(135deg, #5a89c4 0%, #4977b6 100%);
  transform: translateY(2rpx);
}

.delete-btn {
  background: linear-gradient(135deg, #d1727d 0%, #c45d6a 100%);
  color: white;
}

.delete-btn:active {
  background: linear-gradient(135deg, #c45d6a 0%, #b74858 100%);
  transform: translateY(2rpx);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6c757d;
}

/* 添加按钮 */
.add-goal-section {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
}

.add-goal-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(74, 144, 226, 0.3);
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f8f9fa;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f8f9fa;
  color: #6c757d;
  border: none;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-section {
  padding: 30rpx 40rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.form-input {
  height: 80rpx;
}

.form-textarea {
  height: 120rpx;
}

.form-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  min-height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #495057;
}

.picker-content {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  flex: 1;
}

.picker-main {
  font-size: 28rpx;
  color: #495057;
}

.picker-desc {
  font-size: 22rpx;
  color: #6c757d;
}

.picker-arrow {
  font-size: 20rpx;
  color: #adb5bd;
}

.optional {
  color: #6c757d;
  font-size: 22rpx;
  font-weight: normal;
}

/* 目标模板 */
.template-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  margin-top: 16rpx;
}

.template-item {
  flex: 1;
  min-width: 200rpx;
  background: linear-gradient(135deg, #e3f2fd 0%, #f1f8fe 100%);
  border-radius: 12rpx;
  padding: 20rpx;
  border: 2rpx solid #e3f2fd;
  transition: all 0.3s ease;
}

.template-item:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  border-color: #4A90E2;
}

.template-item:active .template-name,
.template-item:active .template-amount {
  color: white;
}

.template-name {
  font-size: 24rpx;
  font-weight: bold;
  color: #1976d2;
  margin-bottom: 8rpx;
  display: block;
}

.template-amount {
  font-size: 22rpx;
  color: #1976d2;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 40rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.cancel-btn {
  background: #f8f9fa;
  color: #6c757d;
}

.save-btn {
  background: #28a745;
  color: white;
}

/* 更新进度弹窗样式 */
.update-modal {
  width: 90%;
  max-width: 600rpx;
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

.update-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.update-goal-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.update-goal-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.update-goal-details {
  display: flex;
  flex-direction: column;
}

.update-goal-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.update-goal-target {
  font-size: 24rpx;
  opacity: 0.9;
}

.close-btn {
  width: 32rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  color: white;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
}

.close-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.9);
}

.update-content {
  padding: 40rpx 30rpx;
}

/* 当前进度显示 */
.current-progress {
  margin-bottom: 40rpx;
}

.progress-visual {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-bottom: 20rpx;
}

.progress-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: conic-gradient(#667eea 0deg, #667eea 126deg, #e9ecef 126deg 360deg);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.progress-circle::before {
  content: '';
  width: 80rpx;
  height: 80rpx;
  background: white;
  border-radius: 50%;
  position: absolute;
}

.progress-percent {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  position: relative;
  z-index: 1;
}

.progress-bar-container {
  flex: 1;
}

.progress-bar-bg {
  width: 100%;
  height: 12rpx;
  background: #e9ecef;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
}

.current-text {
  color: #28a745;
  font-weight: 500;
}

.remaining-text {
  color: #6c757d;
}

/* 金额输入 */
.amount-input-section {
  margin-bottom: 40rpx;
}

.input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: 500;
}

.amount-input-container {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border: 2rpx solid #e9ecef;
  border-radius: 12rpx;
  padding: 0 20rpx;
  transition: border-color 0.3s ease;
}

.amount-input-container:focus-within {
  border-color: #667eea;
  background: white;
}

.currency-symbol {
  font-size: 32rpx;
  color: #6c757d;
  margin-right: 10rpx;
}

.amount-input {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  color: #333;
  background: transparent;
  border: none;
}



/* 预览效果 */
.update-preview {
  padding: 25rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.preview-label {
  display: block;
  font-size: 24rpx;
  color: #6c757d;
  margin-bottom: 10rpx;
}

.preview-progress {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.preview-amount {
  font-size: 32rpx;
  font-weight: 600;
  color: #28a745;
}

.preview-percent {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 500;
}

/* 更新弹窗底部 */
.update-footer {
  display: flex;
  padding: 30rpx;
  gap: 20rpx;
  background: #f8f9fa;
}

.update-footer .cancel-btn, .update-footer .confirm-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  transition: all 0.3s ease;
}

.update-footer .cancel-btn {
  background: #6c757d;
  color: white;
}

.update-footer .cancel-btn::after {
  border: none;
}

.update-footer .cancel-btn:active {
  background: #5a6268;
  transform: scale(0.98);
}

.update-footer .confirm-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.update-footer .confirm-btn::after {
  border: none;
}

.update-footer .confirm-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}
