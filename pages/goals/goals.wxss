.goals-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 120rpx;
}

/* 目标列表 */
.goals-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.goal-item {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s ease;
}

.goal-item:active {
  transform: scale(0.98);
}

.goal-item.completed {
  background: linear-gradient(135deg, #e8f5e8 0%, #f0f8f0 100%);
  border-left: 6rpx solid #28a745;
}

.goal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.goal-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.goal-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.goal-details {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.goal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 8rpx;
}

.goal-category {
  font-size: 24rpx;
  color: #6c757d;
}

.goal-amount {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.current-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #28a745;
}

.target-amount {
  font-size: 24rpx;
  color: #6c757d;
}

/* 进度条 */
.progress-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #e9ecef;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90E2 0%, #28a745 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 24rpx;
  color: #4A90E2;
  font-weight: bold;
  min-width: 80rpx;
  text-align: right;
}

/* 目标底部 */
.goal-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.deadline {
  font-size: 24rpx;
  color: #6c757d;
}

.deadline.urgent {
  color: #ffc107;
  font-weight: bold;
}

.deadline.expired {
  color: #dc3545;
  font-weight: bold;
}

.goal-actions {
  display: flex;
  gap: 10rpx;
}

.action-btn {
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  border: none;
}

.update-btn {
  background: #4A90E2;
  color: white;
}

.delete-btn {
  background: #f8f9fa;
  color: #dc3545;
  border: 1rpx solid #dc3545;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #6c757d;
}

/* 添加按钮 */
.add-goal-section {
  position: fixed;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
}

.add-goal-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #4A90E2 0%, #357ABD 100%);
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(74, 144, 226, 0.3);
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx 20rpx;
  border-bottom: 1rpx solid #f8f9fa;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #212529;
}

.close-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f8f9fa;
  color: #6c757d;
  border: none;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-section {
  padding: 30rpx 40rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #495057;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-input,
.form-textarea {
  width: 100%;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.form-input {
  height: 80rpx;
}

.form-textarea {
  height: 120rpx;
}

.form-picker {
  width: 100%;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #495057;
}

.picker-arrow {
  font-size: 20rpx;
  color: #adb5bd;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx 40rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
}

.cancel-btn {
  background: #f8f9fa;
  color: #6c757d;
}

.save-btn {
  background: #28a745;
  color: white;
}
